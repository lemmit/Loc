// Whole-table aggregation: a SINGLETON query-time projection whose `select` is
// `count()` / `sum()` / `avg()` / `min()` / `max()` over the source table —
// read-path-architecture.md rev. 8's singleton read model, whose motivating use
// is a dashboard total / running count (M-T1.3 Phase 0).
//
// The point of the shape is that the aggregation happens IN SQL.  `.all` is
// paged by default (M-T2.6), so counting rows in the client counts one page;
// and the naive server-side read is a `SELECT *` over the whole table with
// every row rehydrated into a domain object to produce one integer — the exact
// scaling failure M-T2.6 removed from `findAll`.  Each backend emits one query
// (`COUNT(*)`/`SUM(...)`) that materialises no rows.
//
// Exercises, on every backend: all five operators; a criterion `where` lowered
// into the SAME query rather than applied after; the ONE-row response shape (a
// singleton returns the row, not an array of one); and the per-backend
// coercions, which are load-bearing — Postgres returns numeric aggregates as
// strings/Decimals through most drivers and NULL over an empty table, and the
// declared row type (money → string, decimal → number) is the contract the
// response schema is built from.
//
// This is also the first compile coverage of the `select` clause anywhere in
// the corpus; the whole query-time projection surface shipped on five backends
// without it, which is how the aggregation came to emit the operator name as an
// undeclared identifier.
system ProjectionAggregationSys {
  subdomain Sales {
    context Orders {
      enum OrderStatus { Draft Confirmed Cancelled }

      aggregate Order with crudish {
        code: string
        total: money
        lineCount: int
        status: OrderStatus
        derived display: string = code
      }

      repository Orders for Order { }

      criterion Confirmed of Order as o = o.status == OrderStatus.Confirmed

      // Filtered — every operator, `where` pushed into the same query.
      projection SalesTotals {
        orders: int
        revenue: money
        avgLines: decimal
        biggest: money
        smallest: money
        from Order as o
        where Confirmed
        select orders = count(),
               revenue = sum(o.total),
               avgLines = avg(o.lineCount),
               biggest = max(o.total),
               smallest = min(o.total)
      }

      // Unfiltered — the bare whole-table count, the smallest useful KPI.
      projection OrderVolume {
        total: int
        from Order as o
        select total = count()
      }
    }
  }

  api OrdersApi from Sales

  storage pg { type: postgres }
  resource ordersState { for: Orders, kind: state, use: pg }
  deployable d {
    platform: __PLATFORM__
    contexts: [Orders]
    dataSources: [ordersState]
    serves: OrdersApi
    port: 4000
  }

  // The aggregation ran in SQL on five backends and its ANSWERS were checked
  // nowhere — the compile tiers see a query, not a number.  Every coercion this
  // fixture's header calls "load-bearing" (numeric aggregates arriving as
  // strings/Decimals, NULL over an empty table, money→string vs decimal→number)
  // is a value question, so only a runtime caller can ask it.
  test e2e "the aggregation is computed in SQL, and the numbers are right" against d {
    // The EMPTY table first: `count()` must zero-default and the other four
    // operators must survive SQL NULL, which is where a backend that maps a
    // NULL aggregate straight onto a non-nullable response field 500s.
    let empty = api.salesTotals.list()
    expect(empty.orders).toBe(0)
    let none = api.orderVolume.list()
    expect(none.total).toBe(0)

    // Two Confirmed rows and one Draft: the criterion must be folded INTO the
    // aggregate query, so the Draft row moves `OrderVolume` (unfiltered) but
    // not `SalesTotals` (filtered).  A backend that filtered after aggregating
    // — or not at all — reads 3 orders here instead of 2.
    let a = api.orders.create({ code: "O-1", total: money("10.00"), lineCount: 2, status: "Confirmed" })
    let b = api.orders.create({ code: "O-2", total: money("30.00"), lineCount: 4, status: "Confirmed" })
    let draft = api.orders.create({ code: "O-3", total: money("5.00"), lineCount: 1, status: "Draft" })

    let totals = api.salesTotals.list()
    expect(totals.orders).toBe(2)
    // money and decimal cross the wire in different forms (string vs number),
    // so the numeric fold is the portable assertion; the FORM is pinned by the
    // wire-golden differential, which sees the raw response.
    expect(decimal(totals.revenue)).toBe(40)
    expect(decimal(totals.avgLines)).toBe(3)
    expect(decimal(totals.biggest)).toBe(30)
    expect(decimal(totals.smallest)).toBe(10)

    let volume = api.orderVolume.list()
    expect(volume.total).toBe(3)

    // The aggregate's own routes beside the read model — and each write must
    // MOVE the aggregation, which is the part a cached/stale read model fails.
    let readBack = api.orders.getById(a)
    expect(readBack.code).toBe("O-1")
    api.orders.update(a, { code: "O-1b", total: money("20.00"), lineCount: 2, status: "Confirmed" })
    let afterUpdate = api.salesTotals.list()
    expect(decimal(afterUpdate.revenue)).toBe(50)
    expect(afterUpdate.orders).toBe(2)

    let listed = api.orders.all()
    expect(listed.items.length).toBe(3)
    expect(listed.total).toBe(3)

    api.orders.destroy(draft)
    expect(api.orders.getById(draft)).toThrow(404)
    let afterDestroy = api.orderVolume.list()
    expect(afterDestroy.total).toBe(2)
    // …and the FILTERED projection is unmoved by deleting a row it never
    // counted: the criterion still holds after the write.
    let stillTwo = api.salesTotals.list()
    expect(stillTwo.orders).toBe(2)
    expect(decimal(stillTwo.revenue)).toBe(50)

    api.orders.destroy(a)
    api.orders.destroy(b)
    let backToEmpty = api.salesTotals.list()
    expect(backToEmpty.orders).toBe(0)
  }
}
