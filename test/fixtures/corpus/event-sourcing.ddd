// Event sourcing (workflow-and-applier.md): the aggregate's truth is its
// append-only event stream; bodies decide-and-emit, apply(...) folds.
system Ledger {
  subdomain Core {
    context Accounts {
      event Opened { account: Account id, owner: string }
      event Deposited { account: Account id, amount: int }
      event Withdrawn { account: Account id, amount: int }
      aggregate Account persistedAs: eventLog {
        owner: string
        balance: int
        create open(owner: string) { emit Opened { account: id, owner: owner } }
        operation deposit(amount: int) {
          precondition amount > 0
          emit Deposited { account: id, amount: amount }
        }
        operation withdraw(amount: int) {
          precondition amount > 0
          precondition balance >= amount
          emit Withdrawn { account: id, amount: amount }
        }
        apply(e: Opened) { owner := e.owner  balance := 0 }
        apply(e: Deposited) { balance := balance + e.amount }
        apply(e: Withdrawn) { balance := balance - e.amount }
      }
      repository Accounts for Account {
        find byOwner(owner: string): Account? where this.owner == owner
      }
    }
  }
  api LedgerApi from Core
  storage pg { type: postgres }
  resource accountsLog { for: Accounts, kind: eventLog, use: pg }
  deployable d {
    platform: __PLATFORM__
    contexts: [Accounts]
    dataSources: [accountsLog]
    serves: LedgerApi
    port: 4000
  }

  // Runtime validation of the append-only fold (M-T9.12): the aggregate row is
  // NOT the truth — the event stream is, and the balance is reconstructed by
  // replaying Opened/Deposited/Withdrawn through the apply(...) folds on every
  // read.  A backend whose fold mis-orders, double-counts, or drops an event
  // reads back the wrong balance here (compile-clean but runtime-wrong), which
  // the per-feature behavioural legs (all five backends) now catch.
  test e2e "the append-only fold reconstructs balance across deposit + withdraw" against d {
    let a = api.accounts.create({ owner: "alice" })
    api.accounts.deposit(a, { amount: 100 })
    api.accounts.withdraw(a, { amount: 30 })
    let read = api.accounts.getById(a)
    expect(read.owner).toBe("alice")
    expect(read.balance).toBe(70)

    // The root LIST route — `all` on an event-sourced aggregate is a bare
    // ARRAY, not the paged envelope, because it FOLDS every stream rather than
    // slicing one queryable table.  So this is the only caller in the repo that
    // runs the fold in BULK instead of per-id: a backend that replays streams
    // correctly by id but reconstitutes the collection read from a stale
    // snapshot table answers a wrong balance here and nowhere else.
    //
    // Read here, in the FIRST block, while exactly ONE stream exists — the
    // second block opens another account, and a multi-stream fold has no
    // declared order to record.
    let listed = api.accounts.all()
    expect(listed.length).toBe(1)
  }

  // The same fold reconstructed through a non-getById reader (the `byOwner`
  // filter query) — proves the stream reconstitution is reader-independent.
  test e2e "the fold reconstructs balance through a filter-query read" against d {
    let a = api.accounts.create({ owner: "bob" })
    api.accounts.deposit(a, { amount: 250 })
    let found = api.accounts.byOwner({ owner: "bob" })
    expect(found.owner).toBe("bob")
    expect(found.balance).toBe(250)
  }
}
