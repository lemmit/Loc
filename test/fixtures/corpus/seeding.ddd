// Seeding (database-seeding.md): default / demo / wired-raw datasets.
system Seeding {
  subdomain Catalog {
    context Catalog {
      enum Tier { Free, Pro }
      aggregate Widget with crudish {
        name: string
        size: int
        tier: Tier
        invariant size >= 0
        derived display: string = name
      }
      aggregate Gadget with crudish {
        widgetId: Widget id
        label: string
      }
      repository Widgets for Widget { }
      repository Gadgets for Gadget { }
      seed default {
        Widget { name: "Alpha", size: 1, tier: Free }
        Widget { name: "Beta", size: 2, tier: Pro }
      }
      seed demo { Widget { name: "Gamma", size: 3, tier: Pro } }
      seed wired raw {
        Widget { id: "11111111-1111-1111-1111-111111111111", name: "Anchor", size: 4, tier: Free }
        Gadget { id: "22222222-2222-2222-2222-222222222222", widgetId: "11111111-1111-1111-1111-111111111111", label: "g1" }
      }
    }
  }
  api CatalogApi from Catalog
  storage primary { type: postgres }
  resource catalogState { for: Catalog, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Catalog]
    dataSources: [catalogState]
    serves: CatalogApi
    port: 4000
  }

  test e2e "seeded catalog is created and readable" against d {
    let w = api.widgets.create({ name: "Delta", size: 9, tier: "Free" })
    let read = api.widgets.getById(w)
    expect(read.name).toBe("Delta")

    // The canonical `update` over the enum column — the seed datasets write
    // `tier` at first boot through the SEED path, so this is the first time the
    // same column is written through the REQUEST path.  Declared enum casing
    // (`"Pro"`) has to survive both.
    api.widgets.update(w, { name: "Delta-2", size: 10, tier: "Pro" })
    let updated = api.widgets.getById(w)
    expect(updated.name).toBe("Delta-2")
    expect(updated.size).toBe(10)
    expect(updated.tier).toBe("Pro")

    // The SECOND seeded aggregate had no runtime caller at all — its create,
    // read and update were uncalled, so nothing proved the cross-aggregate
    // `Widget id` reference the `wired raw` dataset relies on round-trips
    // through the api as well as through the seeder.
    let g = api.gadgets.create({ widgetId: w.id, label: "g1" })
    let readGadget = api.gadgets.getById(g)
    expect(readGadget.label).toBe("g1")
    expect(readGadget.widgetId).toBe(w.id)
    api.gadgets.update(g, { widgetId: w.id, label: "g2" })
    let updatedGadget = api.gadgets.getById(g)
    expect(updatedGadget.label).toBe("g2")

    // THE COLLECTION READS — the only route class that can see seed data at
    // all, and the reason they were held back until now: the node leg composed
    // `createApp` directly and never reached `runSeeds`, which the generated
    // entrypoints (`index.ts` / `app/main.py` / …) call at boot, so this table
    // started with the `default` dataset's rows on four legs and empty on the
    // fifth.  `run.mjs` now runs the EMITTED seeder too, so all five legs read
    // the same table and these assertions are about the SEEDER rather than
    // about the harness (`R.unseededListRead`, now drained).
    //
    // `sort`/`dir` are explicit because the page carries more than one row and
    // the wire golden diffs item ORDER as its own divergence kind.  The seeded
    // rows are asserted by VALUE, not just counted: `size`/`tier` are the int
    // and enum columns the seeder writes through the domain `create` path, and
    // until this read nothing anywhere had read a seeded row back.
    let all = api.widgets.all({ sort: "name", dir: "asc" })
    expect(all.total).toBe(3)
    expect(all.items.length).toBe(3)
    let alpha = all.items.where(w => w.name == "Alpha").first()
    expect(alpha.size).toBe(1)
    expect(alpha.tier).toBe("Free")
    let beta = all.items.where(w => w.name == "Beta").first()
    expect(beta.size).toBe(2)
    expect(beta.tier).toBe("Pro")
    // `demo` and `wired raw` are opt-in datasets (LOOM_SEED), so their rows must
    // NOT be here — the dataset gate is as much a part of the feature as the
    // insert, and a seeder that ran every dataset would look identical to one
    // that ran the right one until something counted.
    expect(all.items.where(w => w.name == "Gamma").length).toBe(0)
    expect(all.items.where(w => w.name == "Anchor").length).toBe(0)
    // The second seeded aggregate's list route: `Gadget` is only written by the
    // opt-in `wired raw` dataset, so the table holds exactly the one row this
    // test created — the same assertion read from the other side.
    let allGadgets = api.gadgets.all({ sort: "label", dir: "asc" })
    expect(allGadgets.total).toBe(1)
    expect(allGadgets.items.first().label).toBe("g2")

    // DELETE, child BEFORE parent.  `Gadget.widgetId: Widget id` is emitted as
    // a real foreign key with ON DELETE RESTRICT, so this order is not
    // stylistic — the reverse is refused by any backend that runs the emitted
    // migration chain.
    api.gadgets.destroy(g)
    expect(api.gadgets.getById(g)).toThrow(404)
    api.widgets.destroy(w)
    expect(api.widgets.getById(w)).toThrow(404)
    // …and the seeded rows are still there after it: a delete that took the
    // whole table with it would pass every assertion above.
    let afterDelete = api.widgets.all({ sort: "name", dir: "asc" })
    expect(afterDelete.total).toBe(2)
    expect(afterDelete.items.first().name).toBe("Alpha")
  }
}
