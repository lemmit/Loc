// shape: document: whole aggregate tree round-trips one jsonb column.
system DocSys {
  subdomain Cms {
    context Cms {
      aggregate Article shape: document, with crudish {
        title: string
        viewCount: int
        contains sections: Section[]
        entity Section { heading: string  body: string }
        operation addSection(heading: string, body: string) {
          sections += Section { heading: heading, body: body }
        }
        operation bump() { viewCount := viewCount + 1 }
      }
      repository Articles for Article {
        find popular(min: int): Article[] where this.viewCount >= min
      }
    }
  }
  api CmsApi from Cms
  storage primary { type: postgres }
  resource cmsState { for: Cms, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Cms]
    dataSources: [cmsState]
    serves: CmsApi
    port: 4000
  }

  test e2e "document aggregate round-trips the jsonb tree" against d {
    let a = api.articles.create({ title: "T1", viewCount: 0 })
    api.articles.addSection(a, { heading: "H", body: "B" })
    let read = api.articles.getById(a)
    expect(read.title).toBe("T1")

    // The canonical `update` on a `shape: document` aggregate rewrites the
    // ROOT scalars only — `sections` is a containment, not an update param —
    // yet the whole tree lives in ONE jsonb column, so the update has to
    // re-serialize the containment it never received.  A backend that rebuilt
    // the document from the update input alone loses the section here.
    api.articles.update(a, { title: "T2", viewCount: 5 })
    let updated = api.articles.getById(a)
    expect(updated.title).toBe("T2")
    expect(updated.viewCount).toBe(5)
    expect(updated.sections.length).toBe(1)

    // Free adjacents in the same scenario: the domain op that increments the
    // same column the update just set, and the declared find whose threshold
    // that column now crosses.
    api.articles.bump(a)
    let bumped = api.articles.getById(a)
    expect(bumped.viewCount).toBe(6)
    let popular = api.articles.popular({ min: 6 })
    expect(popular.length).toBe(1)

    // The root LIST route.  On `shape: document` the auto-`findAll` is a BARE
    // ARRAY, not the paged envelope (there is no queryable column to page over
    // — the whole tree is one opaque jsonb blob), so this drives the array arm
    // of a derivation every other fixture exercises paged.
    let listed = api.articles.all()
    expect(listed.length).toBe(1)

    // DELETE takes the whole document — root scalars AND the contained sections
    // that live inside the same jsonb column, with no child table to cascade
    // from.  Both the by-id read and the declared find must stop answering.
    api.articles.destroy(a)
    expect(api.articles.getById(a)).toThrow(404)
    let empty = api.articles.all()
    expect(empty.length).toBe(0)
    let gone = api.articles.popular({ min: 0 })
    expect(gone.length).toBe(0)
  }
}
