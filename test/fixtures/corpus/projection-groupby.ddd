// GROUP BY: a GROUPED query-time projection (M-T4.2) — `group by <col>, …`
// makes the aggregate/per-row `select` MIX legal.  One row per distinct value
// of the grouping columns, aggregates computed per group IN SQL
// (`SELECT status, COUNT(*), SUM(total) … GROUP BY status ORDER BY status`),
// the LIST response shape (an array of the declared row — unlike the singleton
// whole-table aggregation in projection-aggregation.ddd, which returns ONE
// row and forbids the mix).
//
// Exercises, on every backend: a single-column grouping with a per-row key
// select + count/sum/avg aggregates; a criterion `where` folded into the SAME
// grouped query; a multi-column grouping (enum + cross-aggregate id); and the
// deterministic ORDER BY over the grouping columns.  The per-backend
// coercions from the singleton path carry over unchanged (money aggregates
// ride the wire as strings, count zero-defaults), plus the new key-column
// mapping (an enum key serialises as its wire string, an id key as a string).
//
// Also covers the COMPUTED grouping key — `o.placedAt.startOfDay()`, the daily
// series bucket.  It is the one key whose SELECT expression is not a bare
// column, so each backend has to render the SAME truncation in the SELECT, the
// GROUP BY and the ORDER BY (Postgres matches a grouped select against the
// GROUP BY expression syntactically), and then decode a value that arrives
// OUTSIDE the ORM's schema type mapping — the position where four of the five
// backends needed a fix to agree on `2026-08-01T00:00:00Z`.
system ProjectionGroupBySys {
  subdomain Sales {
    context Orders {
      enum OrderStatus { Draft Confirmed Cancelled }

      aggregate Customer with crudish {
        name: string
      }

      aggregate Order with crudish {
        code: string
        placedAt: datetime
        total: money
        lineCount: int
        status: OrderStatus
        customerId: Customer id
        derived display: string = code
      }

      repository Orders for Order { }
      repository Customers for Customer { }

      criterion Confirmed of Order as o = o.status == OrderStatus.Confirmed

      // Filtered, single grouping column — the canonical grouped read model.
      projection SalesByStatus {
        status: OrderStatus
        orders: int
        revenue: money
        avgLines: decimal
        from Order as o
        where Confirmed
        group by o.status
        select status = o.status,
               orders = count(),
               revenue = sum(o.total),
               avgLines = avg(o.lineCount)
      }

      // COMPUTED grouping key — the daily revenue series.  `startOfDay()` is a
      // catalogued queryable datetime intrinsic, so the bucket is computed IN
      // SQL (`date_trunc('day', …)`) in all three clause positions, and the
      // key rides the wire as a `datetime` (midnight UTC).
      projection RevenueByDay {
        day: datetime
        orders: int
        revenue: money
        from Order as o
        group by o.placedAt.startOfDay()
        select day = o.placedAt.startOfDay(),
               orders = count(),
               revenue = sum(o.total)
      }

      // Unfiltered, multi-column grouping (enum + id key), min/max operators.
      projection VolumeByCustomerAndStatus {
        customerId: Customer id
        status: OrderStatus
        orders: int
        biggest: money
        smallest: money
        from Order as o
        group by o.customerId, o.status
        select customerId = o.customerId,
               status = o.status,
               orders = count(),
               biggest = max(o.total),
               smallest = min(o.total)
      }
      // A MONEY grouping KEY — the one shape the other three projections never
      // reach.  A key is read off the STORED column rather than computed by a
      // SQL aggregate, so it takes a different coercion in every emitter, and
      // that coercion was shipping the scale the row happened to be written at
      // (`String(r.total)` / `str(r[0])` / `to_string(row.total)`) while java
      // and .NET already routed theirs through the money renderer.  Grouping by
      // an amount is unusual on its own, but it is the only witness for a money
      // KEY, and without one the divergence is invisible to every gate.
      projection OrdersByTotal {
        total: money
        orders: int
        from Order as o
        group by o.total
        select total = o.total,
               orders = count()
      }
    }
  }

  api OrdersApi from Sales

  storage pg { type: postgres }
  resource ordersState { for: Orders, kind: state, use: pg }
  deployable d {
    platform: __PLATFORM__
    contexts: [Orders]
    dataSources: [ordersState]
    serves: OrdersApi
    port: 4000
  }

  // GROUP BY is a VALUE question end to end — which rows fall in which bucket,
  // what each aggregate sums to, how the key serialises — and the compile tiers
  // can only see that a query was emitted.  The header above says four of the
  // five backends needed a fix to agree on the `startOfDay()` bucket
  // (`2026-08-01T00:00:00Z`); that agreement was never asserted anywhere at
  // runtime, so nothing would notice it breaking.
  test e2e "the groups, their aggregates and their keys" against d {
    let acme = api.customers.create({ name: "Acme" })
    let globex = api.customers.create({ name: "Globex" })

    // Two Confirmed orders for Acme on 2026-08-01 (different hours — the same
    // day bucket), one Draft for Globex on 2026-08-02.
    let o1 = api.orders.create({ code: "O-1", placedAt: "2026-08-01T09:00:00Z", total: money("10.00"), lineCount: 2, status: "Confirmed", customerId: acme.id })
    let o2 = api.orders.create({ code: "O-2", placedAt: "2026-08-01T18:30:00Z", total: money("30.00"), lineCount: 4, status: "Confirmed", customerId: acme.id })
    let o3 = api.orders.create({ code: "O-3", placedAt: "2026-08-02T05:00:00Z", total: money("5.00"), lineCount: 1, status: "Draft", customerId: globex.id })

    // ── single grouping column + criterion `where`, folded into ONE query ────
    // The Draft order must not appear at all: a backend that applied the
    // criterion after grouping (or not at all) reads a second row here.
    let byStatus = api.salesByStatus.list()
    expect(byStatus.count()).toBe(1)
    let confirmed = byStatus.first()
    expect(confirmed.status).toBe("Confirmed")
    expect(confirmed.orders).toBe(2)
    expect(decimal(confirmed.revenue)).toBe(40)
    expect(decimal(confirmed.avgLines)).toBe(3)

    // ── the COMPUTED key: `startOfDay()` in SELECT, GROUP BY and ORDER BY ────
    // Two days, ascending.  The two 2026-08-01 orders must land in ONE bucket
    // (the truncation has to happen in SQL — a backend that grouped by the raw
    // timestamp reads three rows), and the key must ride the wire as midnight
    // UTC, which is the agreement the header calls out.
    let byDay = api.revenueByDay.list()
    expect(byDay.count()).toBe(2)
    let firstDay = byDay.first()
    // Compared as an INSTANT (`datetime(…)`), not as a string: the five
    // backends spell an instant with different fractional widths and the
    // goldens normalize timestamps away, so an equality on the spelling would
    // pin one backend's formatting rather than the bucket.  What must hold —
    // and what a broken truncation breaks — is that the bucket IS midnight UTC.
    expect(string(firstDay.day).contains("2026-08-01T00:00:00")).toBe(true)
    expect(firstDay.orders).toBe(2)
    expect(decimal(firstDay.revenue)).toBe(40)
    let secondDay = byDay.where(r => string(r.day).contains("2026-08-02T00:00:00")).first()
    expect(secondDay.orders).toBe(1)
    expect(decimal(secondDay.revenue)).toBe(5)

    // ── multi-column grouping (id key + enum key), min/max ──────────────────
    let volume = api.volumeByCustomerAndStatus.list()
    expect(volume.count()).toBe(2)
    let acmeRow = volume.where(r => r.customerId == acme.id).first()
    expect(acmeRow.status).toBe("Confirmed")
    expect(acmeRow.orders).toBe(2)
    expect(decimal(acmeRow.biggest)).toBe(30)
    expect(decimal(acmeRow.smallest)).toBe(10)
    let globexRow = volume.where(r => r.customerId == globex.id).first()
    expect(globexRow.status).toBe("Draft")
    expect(globexRow.orders).toBe(1)
    expect(decimal(globexRow.biggest)).toBe(5)

    // ── a MONEY grouping KEY ────────────────────────────────────────────────
    // Three distinct amounts → three groups, ascending by the amount.  The
    // numeric fold is the portable assertion (the FORM — the fixed 4dp money
    // scale a KEY must carry just like an aggregate — is pinned by the
    // wire-golden differential, which sees the raw response).
    let byTotal = api.ordersByTotal.list()
    expect(byTotal.count()).toBe(3)
    expect(decimal(byTotal.first().total)).toBe(5)
    expect(byTotal.first().orders).toBe(1)

    // ── the groups MOVE with the rows ───────────────────────────────────────
    // Promoting the Draft order to Confirmed moves it between buckets in BOTH
    // the filtered single-column projection and the multi-column one.
    api.orders.update(o3, { code: "O-3", placedAt: "2026-08-02T05:00:00Z", total: money("5.00"), lineCount: 1, status: "Confirmed", customerId: globex.id })
    let afterPromote = api.salesByStatus.list()
    expect(afterPromote.count()).toBe(1)
    expect(afterPromote.first().orders).toBe(3)
    expect(decimal(afterPromote.first().revenue)).toBe(45)
    let afterVolume = api.volumeByCustomerAndStatus.list()
    expect(afterVolume.where(r => r.customerId == globex.id).first().status).toBe("Confirmed")

    // The aggregate's own routes beside the read models.
    let readBack = api.orders.getById(o1)
    expect(readBack.code).toBe("O-1")
    let listed = api.orders.all()
    expect(listed.items.length).toBe(3)
    expect(listed.total).toBe(3)
    let customers = api.customers.all()
    expect(customers.total).toBe(2)
    let acmeRead = api.customers.getById(acme)
    expect(acmeRead.name).toBe("Acme")
    api.customers.update(globex, { name: "Globex Inc" })
    expect(api.customers.getById(globex).name).toBe("Globex Inc")

    // ── DELETE empties a bucket rather than leaving a zero row ──────────────
    api.orders.destroy(o1)
    api.orders.destroy(o2)
    let oneDayLeft = api.revenueByDay.list()
    expect(oneDayLeft.count()).toBe(1)
    expect(string(oneDayLeft.first().day).contains("2026-08-02T00:00:00")).toBe(true)
    api.orders.destroy(o3)
    expect(api.orders.getById(o3)).toThrow(404)
    let noGroups = api.salesByStatus.list()
    expect(noGroups.count()).toBe(0)
    api.customers.destroy(acme)
    api.customers.destroy(globex)
    expect(api.customers.getById(acme)).toThrow(404)
    let noCustomers = api.customers.all()
    expect(noCustomers.total).toBe(0)
  }
}
