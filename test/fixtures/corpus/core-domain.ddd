// Core domain surface: enum, value object, event, aggregate with containment,
// a derived field, an invariant, an operation, and a custom find.
system CoreShop {
  subdomain Sales {
    context Orders {
      enum Status { Draft, Placed, Cancelled }
      valueobject Money { amount: decimal  currency: string }
      event OrderPlaced { code: string }
      aggregate Order with crudish {
        code: string
        status: Status
        total: Money
        contains lines: Line[]
        entity Line { sku: string  qty: int }
        derived isDraft: bool = status == Status.Draft
        invariant total.amount >= 0
        operation place() { status := Status.Placed }
        operation addLine(sku: string, qty: int) { lines += Line { sku: sku, qty: qty } }

        // Pure-domain (unit) test — exercised on every backend's unit tier.
        // Stresses enum construction, a `Money` value-object literal (decimal),
        // a collection containment (`lines` folds a Line), an enum-valued
        // matcher, a decimal matcher, and a derived-field read (`o.isDraft`) —
        // the cross-backend coercion surface.  All five backends expose the
        // derived as a domain accessor (elixir via the B18 pure-core accessor).
        test "place transitions a draft order and folds a line" {
          let o = Order.create({ code: "CD1", status: Draft, total: Money { amount: 10.00, currency: "USD" } })
          expect(o.isDraft).toBe(true)
          o.addLine("S1", 2)
          o.place()
          expect(o.status).toBe(Placed)
          expect(o.isDraft).toBe(false)
          expect(o.lines.count).toBe(1)
          expect(o.total.amount).toBe(10.00)
        }
      }
      repository Orders for Order {
        find byStatus(s: Status): Order[] where this.status == s
      }
    }
  }
  api OrdersApi from Sales
  storage primary { type: postgres }
  resource ordersState { for: Orders, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Orders]
    dataSources: [ordersState]
    serves: OrdersApi
    port: 4000
  }

  test e2e "core domain: create, add line, place, read, update" against d {
    let o = api.orders.create({ code: "CD1", status: "Draft", total: { amount: 10.00, currency: "USD" } })
    api.orders.addLine(o, { sku: "S1", qty: 2 })
    api.orders.place(o)
    let read = api.orders.getById(o)
    expect(read.status).toBe("Placed")
    api.orders.update(o, { code: "CD2", status: "Placed", total: { amount: 12.00, currency: "USD" } })
    let updated = api.orders.getById(o)
    expect(updated.code).toBe("CD2")

    // The LIST and DELETE routes.  Both are derived on all five backends
    // (`GET /api/orders` at the bare collection root, `DELETE /api/orders/{id}`)
    // and neither had a caller anywhere in the repo until this block: the e2e
    // surface rendered `all` at `/orders/all` (unmounted) and rejected
    // `destroy` outright.  `sort`/`dir` are passed on the multi-row read so the
    // recorded item order is the same on every backend regardless of how each
    // one mints ids — the single-row read after the delete needs no sort.
    let second = api.orders.create({ code: "CD3", status: "Draft", total: { amount: 1.00, currency: "USD" } })
    let both = api.orders.all({ sort: "code", dir: "asc" })
    expect(both.items.length).toBe(2)
    expect(both.total).toBe(2)
    api.orders.destroy(second)
    // This is the first assertion in the repo that drives a
    // `GET /api/<aggs>/{id}` 404, and it immediately found a cross-backend
    // divergence no wire golden had ever recorded: the STATUS agreed everywhere
    // (404) but the ProblemDetails `detail` did not — Hono answered the machine
    // token `"not_found"` and .NET a bare ASP.NET `NotFound()`, against the
    // sentence `"Order <id> not found"` python/java/elixir emit.  Both outliers
    // were fixed rather than waived; the rule is now RS-27
    // (docs/conformance-semantics.md), and this line is what gates it.
    expect(api.orders.getById(second)).toThrow(404)
    let left = api.orders.all()
    expect(left.items.length).toBe(1)
    expect(left.total).toBe(1)

    // The declared ENUM-keyed find, the last route on this aggregate with no
    // caller.  The two rows above sat on opposite sides of its predicate
    // (`Placed` vs `Draft`), and the `Draft` one was just deleted — so asking
    // for each value in turn separates "the enum is bound correctly" from "the
    // filter matched everything": `Placed` must answer the surviving row and
    // `Draft` must answer none.  Declared enum casing has to survive the trip
    // through a query parameter, which is a different coercion from the body
    // path the create/update above exercise.
    let placed = api.orders.byStatus({ s: "Placed" })
    expect(placed.length).toBe(1)
    let drafts = api.orders.byStatus({ s: "Draft" })
    expect(drafts.length).toBe(0)
  }
}
