// Union-returning finds: `Order or NotFound` (404 absence) and `Order option`.
system UF {
  subdomain D {
    context Shop {
      error NotFound { resource: string }
      aggregate Order with crudish { code: string }
      repository Orders for Order {
        find byCode(code: string): Order or NotFound where this.code == code
        find maybeFirst(code: string): Order option where this.code == code
      }
    }
  }
  api A from D
  storage primary { type: postgres }
  resource st { for: Shop, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Shop]
    dataSources: [st]
    serves: A
    port: 4000
  }

  test e2e "union find returns the order and 404s when absent" against d {
    let o = api.orders.create({ code: "C1" })
    let read = api.orders.byCode({ code: "C1" })
    expect(read.code).toBe("C1")

    // The canonical `update` rewrites the very column the union find keys on,
    // so the find must follow it: `C1` stops resolving and `C1B` starts.  A
    // backend whose update route wrote nothing (or answered 204 without
    // saving — the #2342 shape) would still pass a plain read-back against a
    // stale cache, but cannot pass a re-query through a different route.
    api.orders.update(o, { code: "C1B" })
    let byId = api.orders.getById(o)
    expect(byId.code).toBe("C1B")
    let moved = api.orders.byCode({ code: "C1B" })
    expect(moved.code).toBe("C1B")
    expect(api.orders.byCode({ code: "C1" })).toThrow(404)
  }

  // The ABSENCE half the case above is named for but never exercised.  This is
  // the 404 rung of the denial ladder — the last one the wire golden did not
  // reach (403 `requires`, 409 `when`, 422 `precondition` are all pinned), and
  // the only rung whose 7807 `type` is a DECLARED error URI (`/errors/not-
  // found`, RS-16) rather than `about:blank`.
  test e2e "a union find 404s when the row is absent" against d {
    expect(api.orders.byCode({ code: "NOPE" })).toThrow(404)
  }
}
