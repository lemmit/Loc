// Reusable criterion (criterion.md): a zero-arg and an arg-bearing criterion
// used both as capability filters and as a parameterised find criterion.
system Crit {
  subdomain Sales {
    context Orders {
      criterion Active of Order = !this.archived
      criterion InRegion(region: string) of Order = this.region == region
      aggregate Order with crudish {
        code: string
        region: string
        archived: bool
        filter Active
        filter InRegion("EU")
      }
      repository Orders for Order {
        find recent(): Order[] where this.archived == false
      }
    }
  }
  api OrdersApi from Sales
  storage primary { type: postgres }
  resource ordersState { for: Orders, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Orders]
    dataSources: [ordersState]
    serves: OrdersApi
    port: 4000
  }

  test e2e "recent excludes archived orders" against d {
    let a = api.orders.create({ code: "C1", region: "EU", archived: false })
    let read = api.orders.getById(a)
    expect(read.code).toBe("C1")
    api.orders.create({ code: "C2", region: "EU", archived: true })
    let list = api.orders.recent()
    expect(list.length).toBe(1)

    // The WRITE side of the two capability criteria, which nothing drove: the
    // canonical `update` loads the row through `Active` AND `InRegion("EU")`
    // before it writes.  The row stays inside both criteria (still `EU`, still
    // un-archived), so the write lands and the criterion-filtered reads still
    // see exactly one order — `update` must not fall outside the filter regime
    // the finds obey.
    api.orders.update(a, { code: "C1B", region: "EU", archived: false })
    let updated = api.orders.getById(a)
    expect(updated.code).toBe("C1B")
    expect(updated.region).toBe("EU")
    let stillOne = api.orders.recent()
    expect(stillOne.length).toBe(1)

    // The ROOT LIST route under the SAME two capability criteria.  Two rows are
    // in the table; `Active` excludes the archived one, so the page must carry
    // one — and so must `total`, which is a separate count query and therefore
    // a separate place to forget the criteria.  Nothing had ever asked the
    // auto-`findAll` whether it obeys a `filter <Criterion>` at all.
    let listed = api.orders.all()
    expect(listed.items.length).toBe(1)
    expect(listed.total).toBe(1)

    // DELETE through the same criterion regime: the row is inside both criteria
    // so its delete lands, and the criterion-filtered reads empty out.  (The
    // archived row stays in the table and stays invisible — which is why `all`
    // reads 0 afterwards, not 1.)
    api.orders.destroy(a)
    expect(api.orders.getById(a)).toThrow(404)
    let gone = api.orders.recent()
    expect(gone.length).toBe(0)
    let empty = api.orders.all()
    expect(empty.items.length).toBe(0)
    expect(empty.total).toBe(0)
  }
}
