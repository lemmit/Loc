// Command audit (docs/old/proposals/audit-and-logging.md): every successful
// public command action writes an append-only `audit_records` row — who / what
// / when plus before+after wire snapshots — inside the SAME transaction as the
// aggregate save, so the row and the state change commit or roll back together.
//
// Covers BOTH surface forms in one system, because they lower to the same
// per-command flag and every backend gate reads only that:
//
//   - `aggregate Order audited`  — the aggregate-wide form.  Every PUBLIC
//     command (operation, create, destroy) is audited; the `private` operation
//     is NOT, which is how an internal/high-churn command opts out (there is no
//     negation keyword).
//   - `aggregate Shipment`       — per-command `audited` on one operation only,
//     with a second, unmarked operation proving the flag is not aggregate-wide
//     by accident.
//
// The point of putting this in the corpus is the COMPILE tier: the audit
// runtime (entity/row type, repository port, transactional insert) is
// hand-written per backend, so it needs the real compilers — tsc, dotnet build
// /warnaserror, gradle testClasses, mypy --strict, mix compile
// --warnings-as-errors — not just an emitted-string assertion.
system AuditingSystem {
  subdomain Ordering {
    context Ordering {
      // Aggregate-wide: create, cancel and destroy all audited; `recalc` is
      // private and therefore never audited.
      aggregate Order audited {
        reference: string
        quantity: int
        status: int = 0
        create(reference: string, quantity: int) {
          reference := reference
          quantity := quantity
          status := 0
        }
        operation cancel(reason: int) {
          precondition reason >= 0
          status := reason
        }
        private operation recalc() {
          // A literal self-assign (`quantity := quantity`) emits C# that fails
          // CA2245 under /warnaserror — the body just needs to write a field.
          quantity := quantity + 1
        }
        destroy { }
      }
      repository Orders for Order {
        find byReference(reference: string): Order? where this.reference == reference
      }

      // Per-command form: only `dispatch` is audited.  `retag` is deliberately
      // unmarked so the emitted output distinguishes the two on one aggregate.
      aggregate Shipment with crudish {
        code: string
        dispatched: bool
        operation dispatch() audited {
          dispatched := true
        }
        operation retag(code: string) {
          code := code
        }
      }
      repository Shipments for Shipment {
        find byCode(code: string): Shipment? where this.code == code
      }
    }
  }
  api OrderingApi from Ordering
  storage primary { type: postgres }
  resource orderingState { for: Ordering, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Ordering]
    dataSources: [orderingState]
    serves: OrderingApi
    port: 4000
  }

  // Audit rows are not exposed on the operation response, so the runtime
  // assertion here is that an audited command behaves exactly like an unaudited
  // one — the audit write must not change the response, and must not fail the
  // request.  The READ side lives in its own fixture (`audit-history.ddd`),
  // declared for the backends that serve the read endpoint (node + python
  // today; dotnet/java/elixir still write the trail but expose no route).
  // NOTE — `status: int = 0` is deliberately OMITTED from the create call
  // below: a `= default` field is optional create input, and the server
  // supplies the value. That used to hold on node/dotnet/java/python and fail
  // on Elixir, whose Ecto changeset still `validate_required`d the field and so
  // answered 422 ("can't be blank") to a body every other backend accepted.
  // Keeping the omission here makes this fixture the RUNTIME gate for that
  // parity rule on every backend's behavioral leg (the structural gate is
  // test/conformance/create-required-parity.test.ts).
  test e2e "an audited command behaves like any other" against d {
    let o = api.orders.create({ reference: "R1", quantity: 2 })
    api.orders.cancel(o, { reason: 3 })
    let read = api.orders.getById(o)
    expect(read.reference).toBe("R1")
    expect(read.status).toBe(3)
    // The declared find over the column the audited create wrote.
    let byRef = api.orders.byReference({ reference: "R1" })
    expect(byRef.status).toBe(3)

    // The LIST route — an ordinary read, and audit writes only on COMMANDS, so
    // it must not add a row to `audit_records` either.
    let listed = api.orders.all()
    expect(listed.items.length).toBe(1)
    expect(listed.total).toBe(1)

    // The AUDITED DESTROY.  `destroy { }` is a public command on an
    // aggregate-wide `audited` aggregate, so it writes an audit row in the same
    // transaction as the row removal — the only command whose audit snapshot
    // has a `before` and no `after`, and the one command of the three that no
    // test had ever driven.  A backend that wrote the audit row AFTER the
    // delete (or outside the transaction) has an FK-less orphan or a lost row
    // here; a backend that failed the audit insert fails the delete with it.
    api.orders.destroy(o)
    expect(api.orders.getById(o)).toThrow(404)
    expect(api.orders.byReference({ reference: "R1" })).toThrow(404)
    let empty = api.orders.all()
    expect(empty.items.length).toBe(0)
    expect(empty.total).toBe(0)
  }

  // The PER-COMMAND half of this fixture had no runtime caller at all: nothing
  // created a `Shipment`, so neither the audited `dispatch()` nor the unmarked
  // `retag()` nor the crudish `update` was ever driven.  The whole point of the
  // aggregate is that the two commands differ only in whether an audit row is
  // written — a difference that must be INVISIBLE on the response — so driving
  // exactly one of the three and not the others proved nothing.
  test e2e "the audited and unaudited commands of one aggregate behave alike" against d {
    let s = api.shipments.create({ code: "SH-1", dispatched: false })
    let read = api.shipments.getById(s)
    expect(read.code).toBe("SH-1")
    expect(read.dispatched).toBe(false)
    // audited operation — the audit row commits in the same transaction, and
    // the response must look like any other 204.
    api.shipments.dispatch(s)
    let dispatched = api.shipments.getById(s)
    expect(dispatched.dispatched).toBe(true)
    // the deliberately UNMARKED operation right beside it — same route shape,
    // same 204, no audit row.
    api.shipments.retag(s, { code: "SH-2" })
    let retagged = api.shipments.getById(s)
    expect(retagged.code).toBe("SH-2")
    // canonical crudish update — also unaudited, and the third write route.
    api.shipments.update(s, { code: "SH-3", dispatched: true })
    let updated = api.shipments.getById(s)
    expect(updated.code).toBe("SH-3")
    expect(updated.dispatched).toBe(true)
    let found = api.shipments.byCode({ code: "SH-3" })
    expect(found.dispatched).toBe(true)
    // The list route on the per-command form: `Shipment` is NOT aggregate-wide
    // audited, so nothing on this read touches `audit_records` at all.
    let listed = api.shipments.all()
    expect(listed.items.length).toBe(1)
    expect(listed.total).toBe(1)
    // …and its canonical destroy, which — unlike `Order`'s — is UNAUDITED,
    // because on this aggregate only `dispatch` carries the marker.  The pair
    // of destroys across the two blocks is the audited/unaudited contrast on
    // the one command that removes its own subject.
    api.shipments.destroy(s)
    expect(api.shipments.getById(s)).toThrow(404)
    expect(api.shipments.byCode({ code: "SH-3" })).toThrow(404)
    let empty = api.shipments.all()
    expect(empty.items.length).toBe(0)
    expect(empty.total).toBe(0)
  }
}
