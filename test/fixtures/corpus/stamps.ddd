// Lifecycle stamps (capabilities.md): audit timestamps via a typed `auditable`
// capability — fields + onCreate/onUpdate `stamp` blocks the aggregate
// `implements`.  (Typed-capabilities Phase 6 removed the stringly `implements
// "auditable"` group; a capability now co-locates the stamps it contributes.)
system Stamped {
  capability auditable {
    createdAt: datetime, updatedAt: datetime
    stamp onCreate { createdAt := now() }
    stamp onUpdate { updatedAt := now() }
  }
  subdomain D {
    context Shop {
      aggregate Order with crudish {
        code: string
        implements auditable
      }
      repository Orders for Order { }
    }
  }
  api A from D
  storage primary { type: postgres }
  resource st { for: Shop, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Shop]
    dataSources: [st]
    serves: A
    port: 4000
  }

  test e2e "auditable order round-trips" against d {
    let o = api.orders.create({ code: "S1" })
    let read = api.orders.getById(o)
    expect(read.code).toBe("S1")

    // The `stamp onUpdate` half of the capability, which nothing drove: only
    // `onCreate` had ever fired at runtime, because the canonical `update` —
    // the one route on this aggregate that triggers an update stamp — had no
    // caller.  The golden records `updatedAt`'s KEY through the write (its
    // value is normalized as a timestamp), so a backend that never runs the
    // onUpdate block, or drops the column from the update projection, diverges
    // here.
    api.orders.update(o, { code: "S2" })
    let updated = api.orders.getById(o)
    expect(updated.code).toBe("S2")

    // The LIST route carries the stamp columns too.  `createdAt`/`updatedAt`
    // are capability-contributed fields, not declared ones, so they reach the
    // wire through the enrichment's `wireShape` — and the bulk projection is a
    // separate emission from the by-id one on every backend.  A stamp column
    // dropped only from the list DTO shows here and nowhere else.
    let listed = api.orders.all()
    expect(listed.items.length).toBe(1)
    expect(listed.total).toBe(1)

    api.orders.destroy(o)
    expect(api.orders.getById(o)).toThrow(404)
    let empty = api.orders.all()
    expect(empty.items.length).toBe(0)
    expect(empty.total).toBe(0)
  }
}
