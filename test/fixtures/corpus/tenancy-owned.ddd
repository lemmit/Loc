// First-class multi-tenancy (docs/tenancy.md): `tenancy by user.<claim> of
// <Registry>` + the `tenantOwned` prelude capability (tenant column + claim
// stamp + tenant read filter) + `crossTenant` stance marker.  The registry
// (`Organization`) is named-and-verified only — no marker, no generated
// behavior.  Sibling of tenancy-filter.ddd, which hand-writes the same
// filter/stamp the capability provides.
system TenantOwned {
  user { id: guid  tenantId: string }

  tenancy by user.tenantId of Organization

  subdomain Core {
    context Billing {
      aggregate Invoice with tenantOwned, crudish {
        number: string
        amountDue: int
      }
      aggregate Plan crossTenant with crudish {
        code: string
        monthlyPrice: int
      }
      repository Invoices for Invoice {
        find byNumber(n: string): Invoice[] where this.number == n
      }
    }
    context Accounts {
      aggregate Organization with crudish {
        name: string
      }
    }
  }
  api BillingApi from Core
  storage primary { type: postgres }
  resource billingState { for: Billing, kind: state, use: primary }
  resource accountsState { for: Accounts, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Billing, Accounts]
    dataSources: [billingState, accountsState]
    serves: BillingApi
    port: 4000
    auth: required
  }

  // The behavioural harness authenticates as the canonical principal
  // (`tenantId: "acme"`; see cases.mjs DEV_CLAIMS).  Unlike tenancy-filter
  // (explicit user-set `tenantId` field), `tenantOwned` STAMPS the tenant
  // column from the principal on create and AND-s a `tenant == principal`
  // filter into every read.  A single principal can't seed a cross-tenant
  // row (the stamp overrides), so this asserts the round-trip instead: a
  // created invoice's stamped tenant matches the read filter, so the
  // principal sees its OWN row.  A backend that mis-stamps (leaves the
  // built-in default) or over-filters returns 0 — the capability is broken
  // there.  `crossTenant Plan` carries NO filter, so it round-trips too.
  test e2e "tenantOwned stamps the principal's tenant so same-tenant reads round-trip" against d {
    let inv = api.invoices.create({ number: "INV-1", amountDue: 100 })
    let mine = api.invoices.byNumber({ n: "INV-1" })
    expect(mine.length).toBe(1)
    let p = api.plans.create({ code: "PRO", monthlyPrice: 50 })
    let readPlan = api.plans.getById(p)
    expect(readPlan.code).toBe("PRO")

    // The canonical `update` on a `tenantOwned` aggregate: the tenant column is
    // capability-owned, so it is NOT an update param — the write must leave the
    // stamp alone while still being scoped by it.  The read-back through
    // `GET /{id}` (also tenant-filtered, and also previously uncalled) is what
    // proves the row stayed inside the tenant after the write.
    api.invoices.update(inv, { number: "INV-1B", amountDue: 250 })
    let updatedInv = api.invoices.getById(inv)
    expect(updatedInv.number).toBe("INV-1B")
    expect(updatedInv.amountDue).toBe(250)
    // …and the `crossTenant` sibling, which carries NO filter, updates through
    // the same route with no scoping at all.
    api.plans.update(p, { code: "PRO-PLUS", monthlyPrice: 60 })
    let updatedPlan = api.plans.getById(p)
    expect(updatedPlan.code).toBe("PRO-PLUS")
    expect(updatedPlan.monthlyPrice).toBe(60)

    // The ROOT LIST route on BOTH stances, side by side — the read where the
    // capability's filter and the `crossTenant` marker's ABSENCE are the same
    // question asked twice.  `total` matters as much as `items`: it is a second
    // query, and a count that skipped the tenant predicate is a cross-tenant
    // COUNT leak no `items`-only assertion can see.
    let invoices = api.invoices.all()
    expect(invoices.items.length).toBe(1)
    expect(invoices.total).toBe(1)
    let plans = api.plans.all()
    expect(plans.items.length).toBe(1)
    expect(plans.total).toBe(1)

    // DELETE on both stances.  The tenant-owned delete must load through the
    // tenant scope before removing (the same narrowing the update above proved
    // on the write path); the `crossTenant` one has no scope to narrow.
    api.invoices.destroy(inv)
    expect(api.invoices.getById(inv)).toThrow(404)
    let noInvoices = api.invoices.all()
    expect(noInvoices.items.length).toBe(0)
    expect(noInvoices.total).toBe(0)
    let goneFromFind = api.invoices.byNumber({ n: "INV-1B" })
    expect(goneFromFind.length).toBe(0)
    api.plans.destroy(p)
    expect(api.plans.getById(p)).toThrow(404)
    let noPlans = api.plans.all()
    expect(noPlans.items.length).toBe(0)
    expect(noPlans.total).toBe(0)
  }
}
