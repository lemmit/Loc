// Collection READS over a `shape: document` aggregate's own in-memory lists.
//
// Route A already made a document containment a real `embeds_many` on the
// `<Agg>.Data` embed and a scalar array an `{:array, _}` field, so by the time
// an op body runs, `record.lines` and `record.tags` are ordinary Elixir lists —
// exactly what the shared collection-op renderers expect
// (`lines.sum(l => l.qty)` → `Enum.sum(Enum.map(record.lines, fn l -> l.qty
// end))`).  The vanilla document scope gate nevertheless refused EVERY
// collection method (`loom.vanilla-document-unsupported`), because it was
// written before those lists were real; it now admits a collection op whose
// receiver is one of them.
//
// What stays gated, and is deliberately absent from this fixture: a collection
// op over a REFERENCE collection (`X id[]`).  The relational path resolves
// those through a `many_to_many` join table, and a jsonb blob has no join to
// resolve — so that shape is still an honest error, not a mis-emit.
//
// Every backend already emitted this crossing; the fixture exists because the
// ELIXIR half was validate-gated and is the one that had to be re-verified by
// compiling.  Keeping it in the shared corpus means all five keep proving it.
system DocCollectionRead {
  subdomain Sales {
    context Shop {
      aggregate Order shape: document, with crudish {
        reference: string
        total: int = 0
        lineCount: int = 0
        tags: string[]
        contains lines: OrderLine[]
        entity OrderLine {
          sku: string
          qty: int
        }

        // A lambda over the containment list, folded to a scalar.
        operation retotal() {
          total := lines.sum(l => l.qty)
        }
        // A whole-list `.count` read (the member form) plus a filtered count.
        operation recount() {
          lineCount := lines.count
        }
        // A collection predicate in a guard, and a scalar-array membership test.
        operation markBulk() {
          precondition lines.any(l => l.qty > 10)
          precondition tags.contains("bulk")
          total := total + 1
        }
        // The only way to populate the containment over the wire — a create
        // input carries root scalars, not contained parts.
        operation addLine(sku: string, qty: int) {
          lines += OrderLine { sku: sku, qty: qty }
        }
      }
      repository Orders for Order { }
    }
  }
  api ShopApi from Sales
  storage primary { type: postgres }
  resource shopState { for: Shop, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Shop]
    dataSources: [shopState]
    serves: ShopApi
    port: 4000
  }

  // The reads FOLD, so the assertions are on the folded VALUES, not on a shape:
  // a backend that filtered the wrong list, or lost the containment across the
  // re-embed, lands a different number here.
  test e2e "collection reads fold the document's own in-memory lists" against d {
    let o = api.orders.create({ reference: "R1", tags: ["bulk", "rush"] })
    api.orders.addLine(o, { sku: "A", qty: 4 })
    api.orders.addLine(o, { sku: "B", qty: 11 })

    // `lines.sum(l => l.qty)` over the containment the two appends built.
    api.orders.retotal(o)
    let totalled = api.orders.getById(o)
    expect(totalled.total).toBe(15)

    // `lines.count` — the whole-list member read, not a lambda fold.
    api.orders.recount(o)
    let counted = api.orders.getById(o)
    expect(counted.lineCount).toBe(2)

    // Two collection PREDICATES in guards: `.any(λ)` over the containment (the
    // qty-11 line satisfies it) and `.contains` over the scalar array.  A
    // backend that read either list wrong fails the precondition and 422s
    // instead of reaching the increment.
    api.orders.markBulk(o)
    let bulked = api.orders.getById(o)
    expect(bulked.total).toBe(16)
    expect(bulked.lines.length).toBe(2)

    let listed = api.orders.all()
    expect(listed.length).toBe(1)

    // The canonical update rewrites root scalars only — the containment the
    // folds depend on must survive it (same trap `document.ddd` pins).
    api.orders.update(o, { reference: "R2", total: 16, lineCount: 2, tags: ["bulk"] })
    let updated = api.orders.getById(o)
    expect(updated.reference).toBe("R2")
    expect(updated.lines.length).toBe(2)

    api.orders.destroy(o)
    expect(api.orders.getById(o)).toThrow(404)
  }
}
