// Principal-referencing (tenancy) capability filter: `filter this.tenantId ==
// currentUser.tenantId` AND-ed into every read; `auth: required` emits the
// principal accessor the filter resolves through.
system Tenancy {
  user { id: guid  tenantId: string }
  subdomain Core {
    context Ledger {
      aggregate Account with crudish {
        tenantId: string
        balance: int
        filter this.tenantId == currentUser.tenantId
      }
      repository Accounts for Account {
        find byMinBalance(min: int): Account[] where this.balance >= min
      }
    }
  }
  api LedgerApi from Core
  storage primary { type: postgres }
  resource ledgerState { for: Ledger, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Ledger]
    dataSources: [ledgerState]
    serves: LedgerApi
    port: 4000
    auth: required
  }

  // The behavioural harness authenticates as the canonical principal
  // (`tenantId: "acme"`; see cases.mjs DEV_CLAIMS).  The `filter this.tenantId ==
  // currentUser.tenantId` capability filter is AND-ed into every read, so a read
  // must see ONLY this principal's tenant.  Seed one in-tenant row ("acme") and
  // one out-of-tenant row ("other"), then read across both via `byMinBalance` —
  // the out-of-tenant row must be invisible.  A backend that fails to apply the
  // filter returns 2 (cross-tenant leak); the correct answer is 1.
  test e2e "capability filter scopes reads to the authenticated principal's tenant" against d {
    let mineAcct = api.accounts.create({ tenantId: "acme", balance: 100 })
    let theirAcct = api.accounts.create({ tenantId: "other", balance: 200 })
    let mine = api.accounts.byMinBalance({ min: 0 })
    expect(mine.length).toBe(1)

    // The WRITE side of the same capability filter, which no test reached: the
    // canonical `update` must load the row through the filtered scope before
    // it writes.  The in-tenant row is reachable (204 + the new balance reads
    // back), and the by-id read that confirms it is itself filtered — so this
    // one exchange pins filter application on the update path AND on
    // `GET /{id}`, the two routes the tenancy fixtures only ever exercised
    // through a declared find.
    api.accounts.update(mineAcct, { tenantId: "acme", balance: 150 })
    let read = api.accounts.getById(mineAcct)
    expect(read.balance).toBe(150)
    expect(read.tenantId).toBe("acme")

    // The ROOT LIST route under the same filter.  Two rows exist; the filter
    // must make exactly one of them visible — and `total`, which a backend
    // computes with a SECOND query (the count beside the page), has to be
    // filtered too.  A count that forgot the tenant predicate reports `total: 2`
    // over a one-row page: a cross-tenant COUNT leak that every existing
    // assertion (all of them on `items`) is blind to.
    let listed = api.accounts.all()
    expect(listed.items.length).toBe(1)
    expect(listed.total).toBe(1)

    // DELETE ACROSS THE TENANT BOUNDARY — the destructive route, never driven
    // under a capability filter on any backend.  The out-of-tenant row is
    // invisible to this principal, so its delete must be refused exactly the
    // way its read is (404, not 204-and-gone): the filter has to narrow the
    // load-before-delete, not just the read path.
    expect(api.accounts.destroy(theirAcct)).toThrow(404)

    // …and the in-tenant delete succeeds.  The list is then empty even though
    // the other tenant's row is still in the table — the filter reading zero,
    // which is the shape a filter dropped on the empty path would break.
    api.accounts.destroy(mineAcct)
    expect(api.accounts.getById(mineAcct)).toThrow(404)
    let empty = api.accounts.all()
    expect(empty.items.length).toBe(0)
    expect(empty.total).toBe(0)
  }
}
