// Single (non-collection) containment — hidden _parent one-to-one.
system SC {
  subdomain D {
    context Shop {
      aggregate Order with crudish {
        code: string
        contains shipment: Shipment
        entity Shipment { carrier: string  trackingCode: string }
        operation ship(carrier: string, tracking: string) {
          shipment := Shipment { carrier: carrier, trackingCode: tracking }
        }

        // Pure-domain (unit) test — a SINGLE (non-collection) containment set
        // through an op and read back off the domain object.  A single
        // containment is `T | null` on the domain object (unset at create, set
        // by `ship`), so the read exercises the emitters' null-safe field access
        // (TS `!`, Python `cast`); the elixir/java/dotnet reads are already safe.
        test "ship folds the single containment, read back through the struct" {
          let o = Order.create({ code: "SC1" })
          o.ship("UPS", "1Z999")
          expect(o.shipment.carrier).toBe("UPS")
          expect(o.shipment.trackingCode).toBe("1Z999")
        }
      }
      repository Orders for Order { }
    }
  }
  api A from D
  storage primary { type: postgres }
  resource st { for: Shop, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Shop]
    dataSources: [st]
    serves: A
    port: 4000
  }

  test e2e "single containment round-trips through an op" against d {
    let o = api.orders.create({ code: "SC1" })
    api.orders.ship(o, { carrier: "UPS", tracking: "1Z999" })
    let read = api.orders.getById(o)
    expect(read.shipment.carrier).toBe("UPS")
    // The canonical `update` writes only the DECLARED fields — a containment is
    // not an update param — so the folded `shipment` must SURVIVE a `code`
    // rewrite.  A backend whose update path re-saves the aggregate from a
    // partially-loaded root would drop it here and nowhere else.
    api.orders.update(o, { code: "SC2" })
    let updated = api.orders.getById(o)
    expect(updated.code).toBe("SC2")
    expect(updated.shipment.carrier).toBe("UPS")
    // The root list read carries the single containment too — the shape a
    // per-row `getById` alone never proves for the bulk-load path.
    let listed = api.orders.all()
    expect(listed.items.length).toBe(1)
    // …and the canonical DELETE actually removes it.
    api.orders.destroy(o)
    let empty = api.orders.all()
    expect(empty.items.length).toBe(0)
    expect(empty.total).toBe(0)
  }
}
