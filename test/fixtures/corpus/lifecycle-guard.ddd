// The canonical `create` / `destroy` AUTHORIZATION GATE — `requires` inside a
// lifecycle action, on a state-based (not event-sourced) aggregate.
//
// Why this fixture exists: the guard used to be lowered into the IR and then
// read by NO backend.  `canonicalCreate` was consumed as a marker (its
// existence gates whether `POST /<aggs>` and the `static create` factory are
// emitted); `.statements` reached no emitter at all.  A `requires` in a create
// therefore parsed clean, emitted nothing, and left the route OPEN — the worst
// possible failure mode for an authorization clause, because the source says
// the opposite of what runs.
//
// The two halves are deliberately DIFFERENT, because they render in different
// places and only a fixture carrying both proves each:
//
//   * `create` — the guard runs BEFORE the factory, so it has no `this` to
//     read.  It sees the request principal only.  → 403.
//   * `destroy` — the guard runs AFTER the row loads, so it MAY read `this`
//     (here: `quantity == 0`, a state condition on deletion).  The caller
//     already loads the aggregate for reachability, so the same load feeds the
//     guard.  404 (unreachable) wins over 403 (unauthorized).
//
// `Shipment`'s destroy guard mixes a principal term with a row term on purpose:
// a backend that renders the gate against the wrong receiver compiles fine and
// answers the wrong status, so the row half is what makes the placement
// observable.
//
// `Crate` carries the OTHER destroy shape — a PRINCIPAL-ONLY destroy guard,
// which reads no field of the loaded row.  It is not a redundant copy: the
// Phoenix gate binds the loaded record to evaluate the guard, and an unused
// binding is a `mix compile --warnings-as-errors` failure, so a fixture whose
// every destroy guard happens to read `this` cannot observe that class (C1 of
// the M-T3.16 plan).  Its create is deliberately UNGUARDED — the control that
// keeps an "every create is gated" emitter from passing.
//
// COMPILE-tier: the emitted gate is ordinary target code, and the receiver
// binding (`__loaded` / the C# local / the Java entity / the Elixir struct) is
// exactly the kind of thing only a real compiler checks.
system LifecycleGuard {
  user { id: string  permissions: string[] }

  subdomain Ops {
    permissions { manage }

    context Warehouse {
      aggregate Shipment {
        reference: string
        quantity: int = 0

        // Principal-only guard: no `this` exists yet.
        create(reference: string) {
          requires currentUser.permissions.contains(permissions.manage)
        }

        // Principal AND row: the loaded aggregate is the receiver.
        destroy {
          requires currentUser.permissions.contains(permissions.manage) && quantity == 0
        }

        operation restock(by: int) {
          precondition by > 0
          quantity := quantity + by
        }
      }

      repository Shipments for Shipment { }

      // `audited` on top of the gate is deliberate: the audit path is where a
      // denial can land on the WRONG side of the staged row (the .NET defect
      // #2450's gate passed was exactly a gate below the write), and it is the
      // one interaction the compile tiers can observe — an extra load, an extra
      // local, a rollback arm the `case` has no clause for.
      event CrateReady { crate: Crate id }
      // The in-process channel is what makes the workflow below a real
      // SUBSCRIBER — without it no dispatcher is derived and the `factory-let`
      // never reaches an emitter, so the divergence this fixture pins would be
      // invisible again.
      channel Lifecycle {
        carries: CrateReady
        delivery: broadcast
        retention: ephemeral
      }

      aggregate Crate audited {
        label: string

        // No create guard — the ungated control.
        create(label: string) { }

        // Starts the workflow below, which creates a GUARDED Shipment.
        operation release() {
          emit CrateReady { crate: id }
        }

        // Principal-ONLY destroy guard: the gate never reads the loaded row.
        destroy {
          requires currentUser.permissions.contains(permissions.manage)
        }
      }

      repository Crates for Crate { }

      // A WORKFLOW that creates the guarded aggregate — the shape that exposed a
      // one-backend behavioural divergence.  Four backends call the domain
      // factory directly from the workflow body, so the aggregate's create gate
      // never applies; Phoenix gates in the CONTEXT (its LiveView calls the
      // context directly, so a controller gate has a second front door), which
      // also caught this IN-PROCESS caller — a workflow with no request
      // principal, denied by the nil-principal rule.  Same `.ddd`, 200 on four
      // backends and 403/500 on one.  The seam split (`create_<agg>_unguarded`
      // for in-process callers, the gated plain name for request-side doors)
      // is what this fixture pins: the workflow must compile against the ungated
      // entry on Phoenix, and the controller / LiveView must still take the
      // guarded one.
      workflow Receiving {
        crateId: Crate id
        create(e: CrateReady) by e.crate {
          let ship = Shipment.create({ reference: "auto", quantity: 0 })
        }
      }
    }
  }

  // The AUTHORIZED half of every gate.  The denial half is the `AUTHZ_LADDERS`
  // entry for this fixture (`test/behavioral/cases.mjs`) — the two are written
  // together on purpose: an always-deny gate fails this block, a NO-OP gate
  // fails the ladder's `unauthorized` arm, and neither alone can tell the
  // difference.  That is the same two-halves rule `read-gates` states.
  //
  // This could not be written until the dev-stub claim mapper carried a
  // `string[]`: the gate reads `currentUser.permissions.contains(...)` and four
  // of five backends silently dropped the array claim, leaving `permissions`
  // an empty list and every call below a 403 — the block would have asserted
  // the denial three times over and pinned nothing.
  test e2e "the manage permission opens all three gates, and the ungated control needs none" against d {
    // ── GATE 1: principal-only CREATE (no `this` exists yet) ────────────────
    let ship = api.shipments.create({ reference: "SH-1" })
    let read = api.shipments.getById(ship)
    expect(read.reference).toBe("SH-1")

    // ── The UNGATED control: `Crate.create` carries no `requires`. ──────────
    // Its presence is what stops a backend that gates EVERY route from passing
    // this block: gate-everything and gate-nothing both satisfy a file where
    // every call is gated.
    let crate = api.crates.create({ label: "C-1" })
    expect(api.crates.getById(crate).label).toBe("C-1")

    // ── GATE 2: principal AND row — `destroy requires ... && quantity == 0` ──
    // TWO rows, identical principal, different quantity — the only way to show
    // the ROW half is really evaluated.  `restock` is ungated but carries
    // `precondition by > 0`, so quantity moves one way only: a row is brought
    // ABOVE zero, never back down.
    api.shipments.restock(ship, { by: 3 })
    // Principal half TRUE, row half FALSE -> refused, and 403 specifically:
    // the gate denied, it did not fail to find the row (404) or blow up (500).
    expect(api.shipments.destroy(ship)).toThrow(403)
    // Still there — the refusal was real, not a swallowed error.
    expect(api.shipments.getById(ship).reference).toBe("SH-1")

    // A SECOND shipment, left at the default quantity 0.  Same principal, same
    // route, both halves true -> it destroys.  A backend that evaluates only
    // the principal half passes this one and fails the 403 above; one that
    // refuses everything passes the 403 and fails here.  Neither row alone
    // separates those two, which is why both are here.
    let zeroed = api.shipments.create({ reference: "SH-2" })
    api.shipments.destroy(zeroed)
    expect(api.shipments.getById(zeroed)).toThrow(404)

    // The WORKFLOW door.  `release` emits CrateReady, whose in-process
    // subscriber creates a Shipment.  `Crate` is `audited`, so the route runs
    // inside a transaction — and until the dispatch was deferred past that
    // commit, this single call DEADLOCKED the backend (the subscriber queried
    // the root `db` handle the open transaction held; on the node leg's single
    // PGlite connection that never returns).  It is the reason this fixture
    // carried `R.principalLessSubscriberCrash`.
    api.crates.release(crate, { })

    // The ungated COLLECTION reads. Cheap, but they are the only assertion
    // that the list routes answer at all under a permission-gated system —
    // neither carries a `requires`, so a backend that gates every route (the
    // inverse of the #2446 defect) shows up here rather than nowhere.
    let crates = api.crates.all()
    expect(crates.total).toBe(1)
    // TWO shipments now: the SH-1 created above, plus the one the CrateReady
    // subscriber created.  That second row is the whole proof — the dispatch is
    // flushed after the route's transaction commits and awaited before the 204,
    // so by the time `release` returns the subscriber has run and committed.
    // Before the fix this line was unreachable: the call never returned.
    let ships = api.shipments.all()
    expect(ships.total).toBe(2)

    // ── GATE 3: principal-ONLY destroy, on the audited aggregate ────────────
    // The gate never reads the loaded row, so this is the arm where a backend
    // that hoists the guard above the load still passes — and the audited
    // write path is where a denial can land on the wrong side of the staged
    // row (the .NET #2450 shape).
    api.crates.destroy(crate)
    expect(api.crates.getById(crate)).toThrow(404)
  }

  api WarehouseApi from Ops
  storage primary { type: postgres }
  resource warehouseState { for: Warehouse, kind: state, use: primary }

  deployable d {
    platform: __PLATFORM__
    contexts: [Warehouse]
    dataSources: [warehouseState]
    serves: WarehouseApi
    port: 4000
    // The gate reads the request principal, so the deployable must carry auth
    // — without it no backend emits a `User` at all and the guard has nothing
    // to evaluate against.
    auth: required
  }
}
