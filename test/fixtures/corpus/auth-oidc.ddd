// OIDC authentication (auth.md): an OIDC provider config + a `requires`-guarded
// operation; `auth: required` emits the verifier + principal middleware.
system Helpdesk {
  user {
    id: string
    role: string
    email: string
    permissions: string[]
  }
  auth {
    provider: keycloak
    oidc {
      issuer: env("OIDC_ISSUER")
      clientId: env("OIDC_CLIENT_ID")
    }
    sessions: cookie
    claims: { role: "realm_access.roles" }
  }
  subdomain Support {
    context Tickets {
      aggregate Ticket with crudish {
        subject: string
        open: bool
        operation close() {
          requires currentUser.role == "agent"
          open := false
        }
      }
      repository Tickets for Ticket { }
    }
  }
  storage primary { type: postgres }
  resource ticketState { for: Tickets, kind: state, use: primary }
  api SupportApi from Support
  deployable d {
    platform: __PLATFORM__
    contexts: [Tickets]
    serves: SupportApi
    dataSources: [ticketState]
    port: 4000
    auth: required
  }

  // Unlike the dev-stub cluster, this system has an `auth {}` block → the
  // generated OIDC verifier validates a real bearer JWT against the issuer's
  // JWKS.  The behavioural harness stands up an in-process mock issuer
  // (test/behavioral/oidc-mock.mjs) in place of Keycloak and forwards a signed
  // token via E2E_BEARER_TOKEN whose `realm_access.roles == "agent"` satisfies
  // `requires currentUser.role == "agent"`.  The real JWT path runs end to end:
  // discovery → JWKS → signature/issuer verify → claim projection → guard.  A
  // backend whose verifier rejects the valid token, or mis-maps the role claim,
  // fails to close the ticket and the read still shows `open == true`.
  test e2e "OIDC-verified agent principal satisfies the requires-guarded op" against d {
    let t = api.tickets.create({ subject: "SSO broken", open: true })
    api.tickets.close(t)
    let read = api.tickets.getById(t)
    expect(read.open).toBe(false)

    // The canonical `update` is UNGUARDED — no `requires` clause — but it still
    // sits behind `auth: required`, so it exercises the other half of the
    // authenticated surface: a route the verified principal reaches without any
    // authorization predicate.  A backend that hung the `requires` guard off the
    // aggregate rather than off `close()` would 403 here.
    api.tickets.update(t, { subject: "SSO fixed", open: true })
    let reopened = api.tickets.getById(t)
    expect(reopened.subject).toBe("SSO fixed")
    expect(reopened.open).toBe(true)

    // The LIST and DELETE routes, behind the same verified bearer token.  A
    // collection READ and a DELETE are the two route shapes the auth middleware
    // is easiest to mis-mount on (the list sits at the bare collection root,
    // which several backends register last so `/{id}` cannot shadow it, and the
    // DELETE is the only verb on its path) — so this is where a middleware
    // ordering slip shows as a 401 for a token that just worked twice.
    let listed = api.tickets.all()
    expect(listed.items.length).toBe(1)
    expect(listed.total).toBe(1)
    api.tickets.destroy(t)
    expect(api.tickets.getById(t)).toThrow(404)
    let empty = api.tickets.all()
    expect(empty.items.length).toBe(0)
    expect(empty.total).toBe(0)
  }
}
