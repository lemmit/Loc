// `when` canCommand state gate (criterion.md): the operation evaluates the
// predicate before mutating and auto-exposes a GET can-query companion.
system WhenShop {
  subdomain Sales {
    context Orders {
      enum OrderStatus { Draft, Shipped, Cancelled }
      aggregate Order with crudish {
        code: string
        status: OrderStatus
        operation cancel() when this.status != OrderStatus.Shipped && this.status != OrderStatus.Cancelled {
          status := OrderStatus.Cancelled
        }
      }
      repository Orders for Order { }
    }
  }
  api A from Sales
  storage primary { type: postgres }
  resource st { for: Orders, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Orders]
    dataSources: [st]
    serves: A
    port: 4000
  }

  // Behavioural proof of the `when` gate: the same authored suite runs on every
  // backend via the shared HTTP-dispatch harness (one source, N targets).
  test e2e "cancel is state-gated: a shipped order cannot be cancelled" against d {
    // a Draft order is cancellable — the gate's predicate holds
    let ok = api.orders.create({ code: "A1", status: "Draft" })
    api.orders.cancel(ok)
    // a Shipped order is not — the `when` predicate fails → 409 Conflict
    let shipped = api.orders.create({ code: "A2", status: "Shipped" })
    expect(api.orders.cancel(shipped)).toThrow(409)

    // The canonical `update` (`POST /api/orders/{id}/update`, 204 + empty body)
    // is UNGATED — `when` guards `cancel`, not the crudish write path — so the
    // same row a gated command was refused for is still writable.  That is the
    // half of the gate no assertion reached: a backend that widened the `when`
    // predicate onto every command would fail HERE, not on the 409 above.
    api.orders.update(shipped, { code: "A2-REV", status: "Shipped" })
    let revised = api.orders.getById(shipped)
    expect(revised.code).toBe("A2-REV")
    expect(revised.status).toBe("Shipped")

    // The LIST and DELETE routes, on the aggregate whose whole point is a
    // CLOSED state gate.  `shipped` is the row `cancel` was refused for above,
    // and it is the row deleted here: the canonical `DELETE` carries no `when`,
    // so a backend that widened the gate onto the lifecycle routes (the mirror
    // of the `update` case just above) answers 409 instead of 204 — and the
    // list read afterwards would still show two rows.
    let both = api.orders.all({ sort: "code", dir: "asc" })
    expect(both.items.length).toBe(2)
    expect(both.total).toBe(2)
    api.orders.destroy(shipped)
    expect(api.orders.getById(shipped)).toThrow(404)
    let left = api.orders.all()
    expect(left.items.length).toBe(1)
    expect(left.total).toBe(1)
  }
}
