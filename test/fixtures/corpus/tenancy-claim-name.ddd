// `tenancy by user.<claim>` where the claim is NOT named `tenantId`.
//
// Every other tenancy fixture (tenancy-owned, tenancy-filter,
// tenancy-hierarchy) declares the claim as `tenantId`, which happens to be
// the exact name the `tenantOwned` prelude capability hardcodes on the
// principal side of its stamp and filter — so the five backends' compile
// gates could never observe the two names coming apart.  This fixture pulls
// them apart: the claim is `orgId`, while the capability-provided ROW column
// stays `tenantId` (the capability owns that name, and it is not the
// author's to choose).
//
// The binding that must hold: stamp `this.tenantId := currentUser.orgId`,
// read filter `this.tenantId == currentUser.orgId`, and the registry
// self-scope `this.id == currentUser.orgId`.  A backend that reads
// `currentUser.tenantId` here is referencing a claim the principal does not
// have — which the typed backends catch at compile time and the dynamic ones
// only at request time.
system TenantClaimName {
  user { id: guid  orgId: string }

  tenancy by user.orgId of Organization

  subdomain Core {
    context Billing {
      aggregate Invoice with tenantOwned, crudish {
        number: string
        amountDue: int
      }
      repository Invoices for Invoice {
        find byNumber(n: string): Invoice[] where this.number == n
      }

      // The realtime half of the claim-name bug class.  A broadcast channel
      // over a tenant-owned context makes the four SSE backends emit a
      // ROOM-KEYED wire whose key is read off the principal — and the
      // principal's claim here is `orgId`, not `tenantId`.  A backend that
      // spells the row column on the principal side references a member the
      // `User` shape does not have: .NET/Java fail to compile, python raises
      // per publish, node silently reads `undefined` and every connection
      // joins no room (so every tenant-scoped event degrades to a broadcast).
      //
      // Compile-tier witness only: nothing emits these, deliberately.  An
      // `operation` here would add an API route with no caller (the
      // api-caller census) and a request the wire golden has never recorded;
      // the claim-name bug is in the EMITTED realtime module, which the
      // channel declaration alone is enough to produce.
      event InvoiceIssued { invoice: Invoice id  at: datetime }
      // Carries NO `<Agg> id` reference — the A4 witness.  Classifying by
      // "does it carry an id pointing at a tenantOwned aggregate" put this in
      // the GLOBAL set, streaming one tenant's invoice number to every
      // connected tenant.  It is tenant-scoped by default now, degrading to a
      // `type`-only ticket when the tenant key can't be derived.
      event InvoiceReminderSent { note: string  at: datetime }
      channel Lifecycle {
        carries: InvoiceIssued, InvoiceReminderSent
        delivery: broadcast
        retention: ephemeral
      }
    }
    context Accounts {
      aggregate Organization with crudish {
        name: string
      }
    }
  }
  api BillingApi from Core
  storage primary { type: postgres }
  resource billingState { for: Billing, kind: state, use: primary }
  resource accountsState { for: Accounts, kind: state, use: primary }
  deployable d {
    platform: __PLATFORM__
    contexts: [Billing, Accounts]
    dataSources: [billingState, accountsState]
    serves: BillingApi
    port: 4000
    auth: required
  }

  // Same round-trip assertion as tenancy-owned, against a principal whose
  // tenant claim is `orgId` (`cases.mjs` DEV_CLAIMS carries both names).  The
  // create stamps `tenantId` from `currentUser.orgId`; the read filter
  // compares the same pair.  A backend that stamped from a missing claim
  // writes NULL and the filtered read returns 0.
  test e2e "the tenant claim binds by its declared name, not by `tenantId`" against d {
    let inv = api.invoices.create({ number: "INV-1", amountDue: 100 })
    let mine = api.invoices.byNumber({ n: "INV-1" })
    expect(mine.length).toBe(1)

    // The write path binds the same claim under its declared name: the
    // canonical `update` loads the row through `this.tenantId ==
    // currentUser.orgId` before writing, and the by-id read that confirms it
    // resolves through the same pair.  A backend that reached for
    // `currentUser.tenantId` on either route (the exact mix-up this fixture
    // exists to expose) 404s the row it just created.
    api.invoices.update(inv, { number: "INV-1B", amountDue: 250 })
    let updated = api.invoices.getById(inv)
    expect(updated.number).toBe("INV-1B")
    expect(updated.amountDue).toBe(250)

    // The LIST and DELETE routes bind the claim by the same declared name.
    // Both are derived, neither had a caller: a backend that reached for
    // `currentUser.tenantId` on the collection root returns an empty page for a
    // row it can read by id, and one that reached for it on the DELETE 404s a
    // row it just updated.
    let listed = api.invoices.all()
    expect(listed.items.length).toBe(1)
    expect(listed.total).toBe(1)
    api.invoices.destroy(inv)
    expect(api.invoices.getById(inv)).toThrow(404)
    let empty = api.invoices.all()
    expect(empty.items.length).toBe(0)
    expect(empty.total).toBe(0)
  }
}
