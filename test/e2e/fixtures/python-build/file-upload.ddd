// File upload/download on Python (M-T1.2 slice 2a).  A `File` field stores its
// FileRef ({url,key,contentType,size}) in a JSONB column; the deployable serves
// app-level `POST /files` / `GET /files/{key}` over the bound localDisk
// objectStore's raw-bytes adapter.  Compiling this proves File is real on
// Python end-to-end (domain FileRef TypedDict + JSONB schema + repository
// round-trip + endpoints), under ruff + mypy --strict.
system FileUploadSys {
  subdomain Docs {
    context Docs {
      aggregate Doc {
        title: string
        attachment: File
      }
      repository Docs for Doc { }
    }
  }

  api DocsApi from Docs

  storage pg   { type: postgres }
  storage disk { type: localDisk }

  resource docState { for: Docs, kind: state,       use: pg }
  resource docFiles { for: Docs, kind: objectStore, use: disk }

  deployable api {
    platform: python
    contexts: [Docs]
    dataSources: [docState, docFiles]
    serves: DocsApi
    port: 8000
  }
}
