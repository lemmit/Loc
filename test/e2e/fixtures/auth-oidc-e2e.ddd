// OIDC runtime e2e (D-AUTH-OIDC): a Hono backend behind a bundled dev
// Keycloak.  The test boots the compose stack, gets a real token for the
// seeded `demo` user via the password grant, and asserts the generated
// OIDC verifier validates it (JWKS) and maps the claims onto User.
system Helpdesk {
  user {
    id: string
    roles: string[]
    email: string
  }

  auth {
    provider: keycloak
    oidc {
      issuer: env("OIDC_ISSUER")
      clientId: env("OIDC_CLIENT_ID")
    }
    claims: { roles: "realm_access.roles", email: "email" }
  }

  subdomain Support {
    context Tickets {
      aggregate Ticket with crudish {
        subject: string
        open: bool
      }
      repository Tickets for Ticket {
        // Negative-authz runtime gate (M-T3.13): two `requires`-gated reads let
        // the e2e prove the emitted 403 filter actually ENFORCES (not a no-op a
        // compile gate can't see).  The dev Keycloak `demo` user carries realm
        // roles [user, agent] (no admin), so `adminScoped` denies (403) while the
        // `agentScoped` sibling passes (200 — the gate-satisfied control).
        find adminScoped(): Ticket[] requires currentUser.roles.contains("admin")
        find agentScoped(): Ticket[] requires currentUser.roles.contains("agent")
      }

      // A broadcast channel emits the realtime SSE wire at
      // GET /api/realtime/events — an ordinary AUTHENTICATED route (on no
      // bypass list).  The compose leg opens it both ways to prove M-T4.12's
      // two rules at runtime: uncredentialed → 401, and the HttpOnly `session`
      // cookie (the ONLY credential an `EventSource` can present — it cannot
      // set an Authorization header) → 200 `text/event-stream`.
      event TicketClosed { ticket: Ticket id }
      channel Lifecycle {
        carries: TicketClosed
        delivery: broadcast
        retention: ephemeral
      }
    }
  }

  storage primary { type: postgres }
  resource ticketState { for: Tickets, kind: state, use: primary }

  api SupportApi from Support
  deployable api {
    platform: node
    contexts: [Tickets]
    serves: SupportApi
    dataSources: [ticketState]
    port: 3000
    auth: required
  }
}
