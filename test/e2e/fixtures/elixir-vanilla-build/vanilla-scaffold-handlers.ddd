// M-T5.10 handler-param rewrite — Phoenix vanilla compile gate for the
// SCAFFOLDED explicit application/transport layer.  `with scaffoldHandlers`
// synthesises a commandHandler/queryHandler per create / operation / find /
// get-by-id / destroy, each taking a single `command`/`query` RECORD param (and
// reads declaring `<Agg>Response`).  On Phoenix the handler works off a
// string-keyed `run/1` params map, so `explicit-handlers-emit` FLATTENS each
// record into its fields (destructured off `params` by their snake key) and
// rewrites `cmd.<field>` / `query.<field>` to those flat locals — wire-identical
// to the old flat-param form.  A Money-typed operation param exercises the
// value-object arg on the request record; the `find` read proves the collection
// projection (serialize/1's is_list clause) compiles.  The generated project
// must build clean under `mix compile --warnings-as-errors`.
system HandlerScaffold {
  subdomain Sales {
    context Ordering with scaffoldHandlers {
      valueobject Money {
        amount: decimal
        currency: string
        invariant amount >= 0
      }
      enum Priority { low  high }

      aggregate Order {
        code: string
        status: string = "new"
        priority: Priority = Priority.low
        // NO default here, deliberately.  A VALUE-OBJECT-typed field default
        // emits non-compiling code at the wire boundary — the default renders
        // as the DOMAIN class into the WIRE request DTO (python: `Incompatible
        // types ... variable has type "wire_models.Money"`; .NET: CS0246, the
        // domain `Money` is not even in scope there).  TS survives only by
        // structural typing.  That is a separate, pre-existing emitter gap
        // (see the PR discussion) — this fixture exercises the SCALAR and ENUM
        // defaults below, which is what the create-body drop was about.
        total: Money
        create(code: string) { code := code }
        operation reprice(newTotal: Money) { total := newTotal }
        operation escalate(level: Priority) { priority := level }
        operation cancel() { status := "cancelled" }
        destroy { }
      }
      repository Orders for Order {
        find byStatus(status: string): Order[] where this.status == status
        find byPriority(level: Priority): Order[] where this.priority == level
      }
    }
  }
  api SalesApi with scaffoldApi(of: Sales)
  storage pg { type: postgres }
  resource st { for: Ordering, kind: state, use: pg }
  deployable api { platform: elixir  contexts: [Ordering]  dataSources: [st]  serves: SalesApi  port: 5001 }
}
