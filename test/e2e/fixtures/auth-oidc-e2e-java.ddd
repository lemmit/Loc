// OIDC runtime e2e (D-AUTH-OIDC): a Java (Spring Boot) backend behind a
// bundled dev Keycloak.  The Java sibling of auth-oidc-e2e.ddd / -dotnet.ddd
// — same realm/client so one bundled dev Keycloak serves them all.  The test
// gets a real token for the seeded `demo` user via the password grant and
// asserts the generated Java OidcUserVerifier validates it (JWKS) and maps the
// claims onto User, including the dotted `realm_access.roles` path.
system Helpdesk {
  user {
    id: string
    roles: string[]
    email: string
  }

  auth {
    provider: keycloak
    oidc {
      issuer: env("OIDC_ISSUER")
      clientId: env("OIDC_CLIENT_ID")
    }
    claims: { roles: "realm_access.roles", email: "email" }
  }

  subdomain Support {
    context Tickets {
      aggregate Ticket with crudish {
        subject: string
        open: bool
      }
      repository Tickets for Ticket {
        // Negative-authz runtime gate (M-T3.13): two `requires`-gated reads let
        // the e2e prove the emitted 403 filter actually ENFORCES (not a no-op a
        // compile gate can't see).  The dev Keycloak `demo` user carries realm
        // roles [user, agent] (no admin), so `adminScoped` denies (403) while the
        // `agentScoped` sibling passes (200 — the gate-satisfied control).
        find adminScoped(): Ticket[] requires currentUser.roles.contains("admin")
        find agentScoped(): Ticket[] requires currentUser.roles.contains("agent")
      }
    }
  }

  storage primary { type: postgres }
  resource ticketState { for: Tickets, kind: state, use: primary }

  api SupportApi from Support
  deployable api {
    platform: java
    contexts: [Tickets]
    serves: SupportApi
    dataSources: [ticketState]
    port: 8080
    auth: required
  }
}
