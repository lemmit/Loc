// Java `hosts:` fullstack embed (M-T6.5) — Angular arm.
// A `platform: java` deployable `hosts:` a `framework: angular` ui block,
// embedding the Angular SPA under ClientApp/.  Angular's `ng build`
// (@angular/build:application) nests the browser bundle under
// `dist/browser/`, so the Dockerfile copy differs from the vite `dist/`
// react/vue arms and the SvelteKit `build/` arm — the same non-flat
// build-output quirk as svelte.  Controllers stay under /api/*, SpaWebConfig
// serves the bundle from UI_DIR with the index.html fallback.
system HSA {
  subdomain D {
    context Shop {
      aggregate Product with crudish {
        name: string
        price: money
      }
      repository Products for Product { }
    }
  }
  api A from D
  ui Store {
    framework: angular
    page Products {
      route: "/products"
      title: "Products"
      body: Stack { Heading { "Products", level: 2 } }
    }
  }
  storage primary { type: postgres }
  resource st { for: Shop, kind: state, use: primary }
  deployable hsaApp {
    platform: java
    contexts: [Shop]
    dataSources: [st]
    serves: A
    hosts: Store
    port: 8081
    design: angularMaterial
  }
}
