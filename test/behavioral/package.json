{
  "name": "loom-behavioral-harness",
  "private": true,
  "type": "module",
  "description": "Headless behavioral test tier: boots generated Hono apps on PGlite (no docker) and runs their emitted `test e2e` (API) + `test` (unit) suites. See README.md.",
  "scripts": {
    "behavioral": "node run.mjs",
    "behavioral:ui": "node run-ui.mjs",
    "behavioral:pagination": "node pagination.mjs",
    "behavioral:paged-ui": "node paged-ui.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.4.5",
    "@hono/node-server": "^2.0.0",
    "@hono/zod-openapi": "^1.0.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.205.0",
    "@opentelemetry/resources": "^2.1.0",
    "@opentelemetry/sdk-trace-base": "^2.1.0",
    "@opentelemetry/semantic-conventions": "^1.37.0",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.0",
    "esbuild": "^0.24.0",
    "hono": "^4.12.0",
    "pg": "^8.13.0",
    "pino": "^10.3.0",
    "prom-client": "^15.1.0",
    "uuidv7": "^1.0.2",
    "zod": "^4.0.0"
  }
}
