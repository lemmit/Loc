system SvelteShop {

    theme {
        primary: "#3b82f6"
        radius: "md"
    }

    subdomain Sales {
        context Orders {

            enum OrderStatus { Draft, Confirmed, Cancelled }

            valueobject ContactTag { label: string  weight: int }

            aggregate Customer with crudish {
                name: string
                email: string
                // The MONEY-PRIMITIVE form witness (M-T1.23 / audit F18).
                // `crudish` puts every writable field — optionals included —
                // on the generated `update` op, so the scaffolded Customer
                // Detail page's update OperationForm renders the pack's
                // `field-input-money` template.  That is the shape that once
                // emitted TWO `decimal.js` imports into one file (the pack's
                // named import + the page shell's default import) and broke
                // `svelte-check`.  Optional on purpose: `CreateForm` filters
                // optionals out, so the `ui.customers.create({ name, email })`
                // e2e literal below stays valid.
                creditLimit: money?
                tags: ContactTag[]
                invariant name.length > 0
                derived display: string = name
            }

            aggregate Order {
                customerId: Customer id
                status: OrderStatus
                placedAt: datetime
                // The `money` SCALAR — aggregation source for the
                // `RevenueSnapshot` projection below, and the only thing in the
                // Svelte build matrix that drives `moneySchema` through an
                // emitted client module.
                total: money?
                operation confirm() {
                    precondition status == OrderStatus.Draft
                    status := OrderStatus.Confirmed
                }
                derived display: string = "Order"
            }

            repository Customers for Customer { }
            repository Orders for Order {
                find byStatus(status: OrderStatus): Order[] where this.status == status
            }

            criterion ConfirmedOrders of Order as o = o.status == OrderStatus.Confirmed

            // A SINGLETON query-time projection — aggregated in SQL, one object
            // out.  Read by the Welcome page below through
            // `Sales.RevenueSnapshot` (M-T1.3 Phase 1), which is what makes the
            // Svelte build gate compile `src/lib/api/projections.ts` + the
            // single-record `QueryView` binding.
            projection RevenueSnapshot {
                confirmed: int
                revenue: money
                from Order as o
                where ConfirmedOrders
                select confirmed = count, revenue = sum(o.total)
            }

            workflow placeOrder {
                create(customerId: Customer id) {
                    let order = Order.create({
                        customerId: customerId,
                        status: Draft,
                        placedAt: now()
                    })
                }
            }

            event OrderConfirmed { order: Order id, at: datetime }

            channel Lifecycle {
                carries: OrderConfirmed
                delivery: broadcast
                retention: ephemeral
            }
        }
    }

    api SalesApi from Sales

    storage primarySql { type: postgres }
    resource ordersState { for: Orders, kind: state, use: primarySql }

    ui WebApp with scaffold(subdomains: [Sales]) {
        api Sales: SalesApi
        channel Live: Orders.Lifecycle
        on Live.OrderConfirmed(e) { toast("Order " + e.order + " confirmed") }

        component WelcomeCard(name: string) {
            body: Card { "Welcome", Stack { Text { name }, Slot {} } }
        }

        page Welcome {
            route: "/welcome"
            title: "Welcome"
            state {
                count: int = 0
                showDetails: bool = false
            }
            action bump() { count := count + 1 }
            body: Stack {
                Heading { "Svelte shop", level: 1 },
                WelcomeCard { "friend", Text { "(slot content)" } },
                Group {
                    Button { "Bump", onClick: bump, testid: "bump" },
                    Toggle { "Show details", bind: showDetails },
                    Stat { "Count", count }
                },
                Tabs {
                    Tab { "Customers", Text { "Manage customers from the sidebar." } },
                    Tab { "Orders", Text { "Orders tab body." } },
                    testid: "home-tabs"
                },
                Anchor { "Go to customers", to: "/customers", testid: "go-customers" },
                // Projection read (M-T1.3 Phase 1).  Single-record by
                // construction — a singleton returns ONE object, so the walker
                // must not apply collection semantics to it.  `Money { … }`
                // wraps the decimal figure, which is a Decimal client-side.
                QueryView {
                    of: Sales.RevenueSnapshot,
                    loading: Loader { },
                    error: Alert { "Could not load revenue" },
                    empty: Text { "No confirmed orders yet" },
                    data: r => Group {
                        Stat { "Confirmed orders", r.confirmed },
                        Stat { "Revenue", Money { r.revenue } },
                        testid: "revenue-snapshot"
                    }
                }
            }
        }
    }

    deployable api {
        platform: node
        contexts: [Orders]
        dataSources: [ordersState]
        serves: SalesApi
        port: 8080
    }

    deployable web {
        platform: svelte
        targets: api
        ui: WebApp { Sales: api }
        port: 3002
    }

    test e2e "create a customer through the UI" against web {
        let c = ui.customers.create({ name: "Ada", email: "ada@example.com" })
        let read = ui.customers.getById(c)
        expect(read.name).toHaveText("Ada")
    }
}
