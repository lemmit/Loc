<label class="loom-field"{{#if hasA11yIds}} for="{{fieldId}}"{{/if}}>{{#if labelText}}<span class="loom-label">{{{labelText}}}</span>{{/if}}<input class="loom-input"{{#if hasA11yIds}} id="{{fieldId}}"{{#if hasError}} [attr.aria-invalid]="!!( {{{error}}} ) || null" [attr.aria-describedby]="( {{{error}}} ) ? '{{errorId}}' : null"{{/if}}{{/if}}{{{testidAttr}}}{{#if hasBind}} [value]="{{bind}}()" (input)="{{bind}}.set($any($event.target).value)"{{/if}} />{{#if hasError}}@if ( {{{error}}} ) {<span{{#if hasA11yIds}} id="{{errorId}}"{{/if}} class="loom-error" role="alert">\{{ {{{error}}} }}</span>}{{/if}}</label>
