  end

  defp card_shadow(_variant, "none"), do: nil
  defp card_shadow(_variant, "sm"), do: "shadow-sm"
  defp card_shadow(_variant, "md"), do: "shadow-md"
  defp card_shadow(_variant, "lg"), do: "shadow-lg"
  defp card_shadow("raised", _), do: "shadow-md"
  defp card_shadow("flat", _), do: nil
  defp card_shadow(_, _), do: "shadow-sm"

