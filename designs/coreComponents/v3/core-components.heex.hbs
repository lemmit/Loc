  @doc """
  Styled button.  Accepts type=button|submit|reset + arbitrary attrs.
  When `to:` is set, renders a `<.link navigate>` styled as a button
  (matches the DSL Button primitive's `to:` named arg for navigation).
  `testid:` is hoisted onto the rendered element for Playwright drivers.
  """
  attr :type, :string, default: "button"
  attr :class, :string, default: nil
  attr :to, :string, default: nil, doc: "when set, renders as a navigation link"
  attr :variant, :string, default: nil, values: ["primary", "secondary", "ghost", nil],
    doc: "visual rank — the DSL Button's `variant:` named arg"
  attr :testid, :string, default: nil, doc: "data-testid forwarded to the root element"
  attr :rest, :global, include: ~w(form name value disabled phx-click phx-submit phx-disable-with)
  slot :inner_block, required: true

  def button(assigns) do
    classes =
      [
        "inline-flex items-center justify-center rounded-md px-3 py-2 text-sm font-semibold disabled:opacity-50",
        case assigns.variant do
          "secondary" -> "border border-zinc-300 bg-white text-zinc-900 hover:bg-zinc-50"
          "ghost" -> "text-zinc-900 hover:bg-zinc-100"
          _ -> "bg-zinc-900 text-white hover:bg-zinc-700"
        end,
        assigns.class
      ]

    assigns = assign(assigns, :classes, classes)

    # `testid:` is an ALIAS for `data-testid`, folded into @rest rather than
    # written as its own attribute.  Written as `data-testid={@testid}` next to
    # a `{@rest}` spread, an unset (nil) testid SHADOWS a caller-supplied
    # `data-testid` and the attribute never reaches the DOM — measured against
    # a running LiveView, which is how the HEEx UI behavioural leg found it.
    # Folding makes the two channels additive instead of competing.
    assigns =
      if assigns.testid,
        do: assign(assigns, :rest, Map.put(assigns.rest, :"data-testid", assigns.testid)),
        else: assigns

    if assigns.to do
      ~H"""
      <.link navigate={@to} class={@classes} {@rest}>
        {render_slot(@inner_block)}
      </.link>
      """
    else
      ~H"""
      <button type={@type} class={@classes} {@rest}>
        {render_slot(@inner_block)}
      </button>
      """
    end
  end

