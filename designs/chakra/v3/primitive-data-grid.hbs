{{!-- primitive-data-grid — Chakra v3 chrome around a TanStack table instance.

  The `table` binding comes from the walker-emitted child component wrapping
  this markup (src/generator/_walker/primitives/data-grid.ts); a pack decides
  only how the grid LOOKS, never how the row model works. --}}
    <Stack gap="2"{{{testidAttr}}}>
{{#if hasColumnVisibility}}      <HStack gap="3" wrap="wrap">
        {table.getAllLeafColumns().map((col) => (
          <Checkbox.Root
            key={col.id}
            size="sm"
            checked={col.getIsVisible()}
            onCheckedChange={() => col.toggleVisibility()}
          >
            <Checkbox.HiddenInput />
            <Checkbox.Control />
            <Checkbox.Label>{String(col.columnDef.header ?? col.id)}</Checkbox.Label>
          </Checkbox.Root>
        ))}
      </HStack>
{{/if}}      <Table.ScrollArea borderWidth="1px" borderRadius="md">
        <Table.Root size="sm">
          <Table.Header>
            {table.getHeaderGroups().map((hg) => (
              <Table.Row key={hg.id}>
                {hg.headers.map((h) => (
                  <Table.ColumnHeader key={h.id}>
                    {h.column.getCanSort() ? (
                      <Button
                        variant="plain"
                        size="xs"
                        onClick={h.column.getToggleSortingHandler()}
                        aria-label={`Sort by ${String(h.column.columnDef.header ?? h.id)}`}
                      >
                        {flexRender(h.column.columnDef.header, h.getContext())}
                        {h.column.getIsSorted() === "asc" ? " ↑" : h.column.getIsSorted() === "desc" ? " ↓" : ""}
                      </Button>
                    ) : (
                      flexRender(h.column.columnDef.header, h.getContext())
                    )}
{{#if hasFilters}}                    {h.column.getCanFilter() ? (
                      <Input
                        size="xs"
                        mt="1"
                        {{{filterPlaceholderAttr}}}
                        aria-label={`Filter by ${String(h.column.columnDef.header ?? h.id)}`}
                        value={String(h.column.getFilterValue() ?? "")}
                        onChange={(e) => h.column.setFilterValue(e.target.value)}
                      />
                    ) : null}
{{/if}}                  </Table.ColumnHeader>
                ))}
              </Table.Row>
            ))}
          </Table.Header>
          <Table.Body>
            {table.getRowModel().rows.map((r) => (
              <Table.Row key={r.id}>
                {r.getVisibleCells().map((c) => (
                  <Table.Cell key={c.id}>{flexRender(c.column.columnDef.cell, c.getContext())}</Table.Cell>
                ))}
              </Table.Row>
            ))}
          </Table.Body>
        </Table.Root>
      </Table.ScrollArea>
      <HStack justify="space-between">
        <Button size="xs" variant="outline" onClick={() => table.previousPage()} disabled={!table.getCanPreviousPage()}>
          {{{prevLabel}}}
        </Button>
        <Text fontSize="sm" aria-live="polite">
          {{{pageOfLabel}}}
        </Text>
        <Button size="xs" variant="outline" onClick={() => table.nextPage()} disabled={!table.getCanNextPage()}>
          {{{nextLabel}}}
        </Button>
      </HStack>
    </Stack>
