{{!-- primitive-data-grid — Chakra v2 chrome around a TanStack table instance.

  The `table` binding comes from the walker-emitted child component wrapping
  this markup (src/generator/_walker/primitives/data-grid.ts); a pack decides
  only how the grid LOOKS, never how the row model works. --}}
    <Stack gap="2"{{{testidAttr}}}>
{{#if hasColumnVisibility}}      <HStack gap="3" wrap="wrap">
        {table.getAllLeafColumns().map((col) => (
          <Checkbox
            key={col.id}
            size="sm"
            isChecked={col.getIsVisible()}
            onChange={() => col.toggleVisibility()}
          >
            {String(col.columnDef.header ?? col.id)}
          </Checkbox>
        ))}
      </HStack>
{{/if}}      <TableContainer borderWidth="1px" borderRadius="md">
        <Table size="sm">
          <Thead>
            {table.getHeaderGroups().map((hg) => (
              <Tr key={hg.id}>
                {hg.headers.map((h) => (
                  <Th key={h.id}>
                    {h.column.getCanSort() ? (
                      <Button
                        variant="plain"
                        size="xs"
                        onClick={h.column.getToggleSortingHandler()}
                        {{{sortByAria}}}
                      >
                        {flexRender(h.column.columnDef.header, h.getContext())}
                        {h.column.getIsSorted() === "asc" ? " ↑" : h.column.getIsSorted() === "desc" ? " ↓" : ""}
                      </Button>
                    ) : (
                      flexRender(h.column.columnDef.header, h.getContext())
                    )}
{{#if hasFilters}}                    {h.column.getCanFilter() ? (
                      <Input
                        size="xs"
                        mt="1"
                        {{{filterPlaceholderAttr}}}
                        {{{filterByAria}}}
                        value={String(h.column.getFilterValue() ?? "")}
                        onChange={(e) => h.column.setFilterValue(e.target.value)}
                      />
                    ) : null}
{{/if}}                  </Th>
                ))}
              </Tr>
            ))}
          </Thead>
          <Tbody>
            {table.getRowModel().rows.map((r) => (
              <Tr key={r.id}>
                {r.getVisibleCells().map((c) => (
                  <Td key={c.id}>{flexRender(c.column.columnDef.cell, c.getContext())}</Td>
                ))}
              </Tr>
            ))}
          </Tbody>
        </Table>
      </TableContainer>
      <HStack justify="space-between">
        <Button size="xs" variant="outline" onClick={() => table.previousPage()} isDisabled={!table.getCanPreviousPage()}>
          {{{prevLabel}}}
        </Button>
        <Text fontSize="sm" aria-live="polite">
          {{{pageOfLabel}}}
        </Text>
        <Button size="xs" variant="outline" onClick={() => table.nextPage()} isDisabled={!table.getCanNextPage()}>
          {{{nextLabel}}}
        </Button>
      </HStack>
    </Stack>
