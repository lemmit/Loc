{{!-- app.html.heex — the LiveView app layout.  Two variants: the sidebar
     chrome (a LiveView app with a `ui:` block) and the minimal header
     (embedded-SPA hosts / no sidebar).  `skipToContent` / `primaryNavAria`
     arrive pre-rendered by the generator (raw English, or the pgettext
     call under i18n) — the template only places them. --}}
{{#if hasSidebar}}
<div class="flex min-h-screen">
  <a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:border focus:bg-base-100 focus:px-4 focus:py-2 focus:text-sm focus:font-medium">{{{skipToContent}}}</a>
  <nav aria-label={{{primaryNavAria}}} class="w-64 flex-shrink-0 border-r border-base-300 bg-base-100">
    <{{webModule}}.Components.Sidebar.sidebar current_path={@current_path}{{#if currentUser}} current_user={@current_user}{{/if}} />
  </nav>
  <main id="main-content" class="flex-1 px-4 py-8 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-4xl">
      <.flash_group flash={@flash} />
      <%= @inner_content %>
    </div>
  </main>
</div>
{{else}}
<a href="#main-content" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:border focus:bg-base-100 focus:px-4 focus:py-2 focus:text-sm focus:font-medium">{{{skipToContent}}}</a>
<header class="px-4 sm:px-6 lg:px-8">
  <div class="flex items-center justify-between border-b border-base-300 py-3 text-sm">
    <div class="flex items-center gap-4">
      <nav aria-label={{{primaryNavAria}}} class="flex items-center gap-4 font-semibold leading-6 text-base-content">
        <a href="/">{{{chrome "homeLink"}}}</a>
      </nav>
    </div>
  </div>
</header>
<main id="main-content" class="px-4 py-20 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl">
    <.flash_group flash={@flash} />
    <%= @inner_content %>
  </div>
</main>
{{/if}}
