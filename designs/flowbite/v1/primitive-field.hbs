<Label class="flex flex-col gap-2"><span>{{{labelText}}}</span>{{#if hasBind}}<Input{{#if hasA11yIds}} id="{{fieldId}}"{{#if hasError}} aria-invalid={!!( {{{error}}} )} aria-describedby={( {{{error}}} ) ? "{{errorId}}" : undefined}{{/if}}{{/if}} value={{expr bind}} oninput={(e) => { {{bind}} = (e.currentTarget as HTMLInputElement).value; }}{{{testidAttr}}} />{{else}}<Input{{{testidAttr}}} />{{/if}}{{#if hasError}}{#if ( {{{error}}} )}<p{{#if hasA11yIds}} id="{{errorId}}"{{/if}} class="text-sm text-red-600">{ {{{error}}} }</p>{/if}{{/if}}</Label>