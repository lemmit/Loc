// Expression-vocabulary showcase — the frontend's `ExprIR` coverage fixture.
//
// WHY THIS FILE EXISTS.  The frontend body walker (`_walker/walker-core.ts`)
// renders page/component expressions through a dispatcher that, unlike the
// backends' `_expr/target.ts`, has no totality contract: an `ExprIR.kind` with
// no arm falls through to `/* unsupported expr: … */ undefined`, and a method
// call with no snippet table is emitted VERBATIM.  Neither failure was
// visible, because a scan of every `.ddd` in the repo found ZERO page bodies
// using a scalar intrinsic or a value-object construction.  The per-frontend
// build gates (`generated-{react,vue,svelte,angular}-build`) were green
// because they had no coverage, not because the code worked.
//
// This fixture is that coverage.  It exercises the `ExprIR` kinds and every
// row of the `src/util/intrinsics.ts` catalogue in page/component bodies, and
// is wired into the React build matrix, so `tsc --noEmit` actually compiles
// these paths.  `test/generator/_walker/render-degradation.test.ts` asserts the
// emitted output carries no degradation sentinel, on every frontend.
//
// Deliberately NOT here: stdlib COLLECTION ops in a page body
// (`rows.count`, `rows.where(…)`).  Those are honestly rejected by
// `loom.frontend-collection-op-unsupported` — a gated construct belongs in the
// validator's negative tests, not in a fixture that must generate cleanly.
//
// Bodies use the BUILDER-BRACE form (`Stack { … }`) throughout — that is what
// `src/language/print/` emits, so the file round-trips through
// `print-structural-roundtrip` and `builder-page-model`.

system ExpressionShowcase {

  subdomain Catalog {
    context Products {

      enum Tier { Basic, Plus, Premium }

      valueobject Money {
        amount: decimal
        currency: string
      }

      // `audited` is what gives the ui a derived `history(id)` read to bind a
      // `Timeline` to.  The primitive is the fixture's one call site with a
      // per-target `default:` degradation arm (`_walker/primitives/
      // timeline.ts`), so it is what makes the `not yet supported on
      // <framework>` sentinel reachable instead of theoretical.
      aggregate Product audited {
        name: string
        sku: string
        note: string
        quantity: int
        weight: decimal
        tier: Tier
        active: bool

        // The BACKEND half of every cross-surface pair below.  The same
        // expression written in a page body must render to the same MEANING;
        // `js-intrinsics.test.ts` pins the agreement for the JS frontends.
        derived shoutName: string = name.toUpper()
        derived quietName: string = name.toLower()
        derived tidySku: string = sku.trim()
        derived skuHead: string = sku.substring(0, 3)
        derived noteClean: string = note.replace("--", "-")
        derived hasDash: bool = sku.contains("-")
        derived absQty: int = quantity.abs()
        derived roundedWeight: decimal = weight.round(2)

        // One PUBLIC command, which is what `audited` above actually attaches
        // to: `aggHasAuditedTarget` is false for an aggregate with no command
        // actions, and without it no `history(id)` read is derived and the
        // `Timeline` on `ProductHistory` would have nothing to bind.
        operation restock(by: int) { quantity := quantity + by }
      }

      repository Products for Product { }
    }
  }

  api CatalogApi from Catalog

  storage db { type: postgres }
  resource productsState { for: Products, kind: state, use: db }

  ui Showcase {
    framework: react
    api Catalog: CatalogApi

    // ---- component params: a non-string param must type as a non-string ---
    component TierBadge(label: string, level: int) {
      body: Stack {
        Text { label },
        Text { level > 2 ? "high" : "low" },
        Text { string((level + 1) * 2) },
        Text { string(-level) }
      }
    }

    // ---- the other component shapes ---------------------------------------
    // `TierBadge` above is props-only, and for a long time that was the whole
    // of this fixture's component coverage — which is why the
    // `unknown layout component` sentinel could not fire here.  A dropped
    // component takes its declaration AND every call site with it: the walker
    // never learns the name, so each use renders
    // `unknown layout component: X` and the element silently disappears.  That
    // is not hypothetical — both shapes below were target-wide drops within
    // the last month (#2602: `derived`- and `state`-bearing components vanished
    // whole on Feliz and Flutter).
    //
    // Each has its OWN emission path per frontend (Feliz folds state into the
    // one Elmish Model and takes the Model as a leading curried arg; Flutter
    // into a Notifier; Angular emits a standalone `@Component`), so covering
    // one covers neither of the others.  Both are called from `ComponentShapes`
    // below — the call site is the half that shows the drop.
    //
    // The THIRD shape — a READ-BEARING component (#2568) — is deliberately not
    // here.  It does not compile on React / Vue / Svelte today: the component
    // walk is handed empty api-param maps, so `Catalog.Product.all` resolves to
    // nothing and the body emits `/* unresolved: Catalog */ undefined.Product
    // .all.isLoading`.  This fixture is compiled by `generated-react-build` and
    // its siblings, so hosting it here would turn those gates red for a defect
    // this PR does not fix.  It is pinned instead as a ratcheting case in
    // `render-degradation.test.ts` (`READ_BEARING_COMPONENT_BROKEN`), against a
    // purpose-built system that nothing compiles.

    // state + action — the component owns a cell and a handler that writes it.
    component Counter(caption: string) {
      state { n: int = 0 }
      action bump() { n := n + 1 }
      body: Stack {
        Text { caption },
        Text { string(n) },
        Button { "+", onClick: bump }
      }
    }

    // derived — including a derived that reads an EARLIER derived, which is
    // the arm that made Feliz spell `model.Tier` for a plain local.
    component ScoreTier(score: int) {
      derived tier: string = score > 90 ? "gold" : "silver"
      derived shout: string = tier.toUpper()
      body: Stack { Text { tier }, Text { shout } }
    }

    // ---- every scalar intrinsic, in a user-visible slot -------------------
    page Intrinsics {
      route: "/intrinsics"
      state {
        s: string = "  Hello-World  "
        n: int = -7
        d: decimal = 3.14159
        // `money` is a decimal.js `Decimal` on the JS frontends, a distinct
        // representation from `decimal`'s plain number — so its intrinsics
        // render through DIFFERENT snippets (`Decimal.min` vs `Math.min`) and
        // need the binding in scope.  Without a money-typed state field here
        // nothing in the repo exercised those arms, which is exactly why they
        // shipped declined-then-verbatim.  Init uses the `money(...)`
        // conversion form: a BARE decimal literal init (`m: money = 1.50`)
        // still mis-renders as `useState<Decimal>(1.50)` — a separate,
        // pre-existing bug, see this fixture's PR.
        m: money = money("12.50")
        cap: money = money("9.99")
      }
      body: Stack {
        Heading { "Scalar intrinsics" },

        // string intrinsics — all nine catalogue rows
        Stat { "trim", s.trim() },
        Stat { "toUpper", s.toUpper() },
        Stat { "toLower", s.toLower() },
        Stat { "substring", s.substring(2, 5) },
        Stat { "startsWith", string(s.startsWith("  ")) },
        Stat { "endsWith", string(s.endsWith("  ")) },
        Stat { "contains", string(s.contains("Hello")) },
        Stat { "replace", s.replace("-", " ") },
        Stat { "split", string(s.split("-")) },

        // numeric intrinsics
        Stat { "abs", string(n.abs()) },
        Stat { "min", string(n.min(0)) },
        Stat { "max", string(n.max(0)) },
        Stat { "divTrunc", string(n.divTrunc(2)) },
        Stat { "round", string(d.round(2)) },
        Stat { "floor", string(d.floor()) },
        Stat { "ceil", string(d.ceil()) },

        // money intrinsics — the arms that name the `Decimal` binding.
        // `min`/`max`/`round` are the three that were declined outright;
        // `abs`/`floor`/`ceil` already rendered and are pinned against churn.
        Stat { "money.min", string(m.min(cap)) },
        Stat { "money.max", string(m.max(cap)) },
        Stat { "money.round", string(m.round(2)) },
        Stat { "money.abs", string(m.abs()) },
        Stat { "money.floor", string(m.floor()) },
        Stat { "money.ceil", string(m.ceil()) }
      }
    }

    // ---- the structural expression kinds ---------------------------------
    page Kinds {
      route: "/kinds"
      state {
        count: int = 3
        flag: bool = true
        label: string = "kinds"
      }
      derived doubled: int = count * 2
      body: Stack {
        Heading { "Expression kinds" },

        // paren — grouping that used to render as `undefined`
        Stat { "paren", string((count + 1) * 2) },
        // cast
        Stat { "cast", string(count) },
        // ternary
        Stat { "ternary", flag ? "yes" : "no" },
        // unary
        Stat { "unary", string(!flag) },
        // binary chain + a `derived` ref
        Stat { "binary", string(count + doubled - 1) },
        // match
        Stat { "match", match {
          count > 5 => "many",
          count > 1 => "some",
          else => "none"
        } },
        // interpolated template (concat / ICU lowering)
        Text { `Label {label} has {count} items` },
        // value-object construction — a VO is a plain record on the wire
        Stat { "valueObject", Money(9.99, "USD").currency },
        // user component with named args, passing a NON-STRING param
        TierBadge { label: label, level: count }
      }
    }

    // ---- list/table lambdas + api reads ----------------------------------
    page ProductList {
      route: "/products"
      body: QueryView { of: Catalog.Product.all, data: rows => Table {
        Column { "Name", p => p.name },
        Column { "Shout", p => p.shoutName },
        Column { "Sku head", p => p.skuHead },
        Column { "Qty", p => string(p.quantity) },
        rows: rows
      } }
    }

    // ---- the component shapes, at a call site -----------------------------
    // The call sites are the half that matters: a component the target failed
    // to emit is only visible HERE, as `unknown layout component: X`.
    page ComponentShapes {
      route: "/components"
      state { level: int = 3 }
      body: Stack {
        Heading { "Component shapes" },
        TierBadge { label: "props-only", level: level },
        Counter { caption: "hits" },
        ScoreTier { score: 95 }
      }
    }

    // ---- the audit trail — a primitive with a per-target `default:` arm ----
    // `Timeline` renders on all seven frontends today (#2569 closed the last
    // three).  It is in this fixture because it is the one primitive whose
    // emitter still HAS a give-up arm to fall into, so the
    // `not yet supported on <framework>` sentinel has something real to watch:
    // delete one `case` from `_walker/primitives/timeline.ts` and this page
    // starts carrying the comment.
    //
    // NOTE the BARE `Product.history(id)` — not `Catalog.Product.history(id)`
    // like every other read in this file.  The derived history read is added
    // in phase ⑥ enrichment, but `checkApiBodyRefs`'s allowlist
    // (`listValidApiOperations`, a phase-④ AST validator) is built from
    // DECLARED finds + operations only, so the api-handle spelling is rejected
    // with "Operation 'history' is not declared on aggregate 'Product'".  The
    // scaffolded History section never hits it because a scaffolded ui has no
    // `api X: Y` param and the check returns early on `apiByParam.size === 0`.
    // The bare form is the same one the scaffold emits and the walker's
    // `isEntityHistoryRead` explicitly accepts; teaching the AST allowlist
    // about the derived read is its own slice.
    page ProductHistory {
      route: "/products/:id/history"
      body: QueryView {
        of: Product.history(id),
        data: entries => Timeline { of: entries, testid: "product-history" }
      }
    }

    // ---- route `id` + detail scope ---------------------------------------
    page ProductDetail {
      route: "/products/:id"
      body: QueryView { of: Catalog.Product.byId(id), single: true, data: p => Stack {
        Heading { p.name },
        // an intrinsic on a WIRE field, in the detail scope
        Stat { "Upper", p.name.toUpper() },
        Stat { "Qty", string(p.quantity) }
      } }
    }
  }

  deployable api {
    platform: node
    contexts: [Products]
    dataSources: [productsState]
    serves: CatalogApi
    port: 3000
  }

  deployable web_app {
    platform: static
    targets: api
    port: 3001
    ui: Showcase { Catalog: api }
  }
}
