// Flutter-frontend twin of `sales-system.ddd`: the same Sales context and Hono
// (`platform: node`) backend, but the frontend deployable is `platform: flutter`
// (Dart/Riverpod, built with the Flutter SDK) instead of react.  Kept SEPARATE so
// the headless full-stack UI tier can drive a REAL generated Flutter web client
// against the REAL generated Hono backend (PGlite, in-process) — the round-trip
// the per-PR React cell covers for React only, and the ONE frontend that had no
// runtime tier at all (its gates were compile-only: `flutter analyze` +
// `flutter build web`).
//
// Driven by `test/behavioral/run-ui-flutter.mjs`, NOT `run-ui.mjs`: Flutter web
// renders to a CANVAS, so the emitted testid-driven `*.ui.spec.ts` page objects
// (which the five DOM frontends share) have nothing to select — the flutter
// emitter deliberately emits no `e2e/playwright.config.ts`, mapping `testid:`
// onto a widget `Key` for `flutter_test` instead.  The flutter leg therefore
// asserts the round-trip one layer down, at the WIRE: the built bundle is served
// same-origin with the real backend, and the app's own reads must reach it, be
// answered 2xx, and decode without a Dart runtime error.  That is precisely the
// layer `flutter analyze` / `flutter build web` are blind to.
//
// Everything above the `deployable` block is byte-identical to the react twin.

requirement US-001 {
  type: UserStory
  title: "A customer can place an order"
  status: InProgress
}

requirement AC-001 parent US-001 {
  type: AcceptanceCriteria
  title: "An order can only be confirmed when it has at least one line"
}

requirement AC-002 parent US-001 {
  type: AcceptanceCriteria
  title: "Lines can only be added while the order is still a draft"
}

system SalesSystem {

  // Visual identity — design tokens land in the generated theme.  The four
  // tokens are framework-agnostic, so the same source applies whether the
  // generator targets React/Mantine or Flutter's Material `ThemeData`.
  theme {
    primary: "#0ea5e9"
    neutral: "#64748b"
    radius: "md"
    fontFamily: "Inter, system-ui, sans-serif"
  }

  subdomain Sales {
    context Sales {

      enum OrderStatus { Draft, Confirmed, Shipped, Cancelled }

      valueobject Money {
        amount: decimal
        currency: string
        invariant amount >= 0
        invariant currency.length == 3
      }

      event OrderConfirmed { order: Order id, at: datetime }

      aggregate Customer with crudish {
        name: string
        email: string
        invariant email.length > 0
        derived display: string = name
      }

      aggregate Product with crudish {
        sku: string
        price: Money
        // `File` as an AGGREGATE FIELD — the shape whose Dart emission once
        // produced the non-parsing `FileRef??` (a `File` already spells the
        // NULLABLE `FileRef?`, so appending the optional marker doubled it).
        // It is here so the leg's `flutter build web` step actually REACHES
        // that emitter branch: without a File field anywhere in the fixture,
        // re-seeding that defect leaves this leg green.  Optional, so the
        // fixture seeding needs no upload.
        spec: File?
        invariant sku.length > 0
        derived display: string = sku
      }

      aggregate Order with crudish {
        customerId: Customer id
        status: OrderStatus
        placedAt: datetime
        contains lines: OrderLine[]

        invariant lines.count > 0 when status == Confirmed

        function isMutable(): bool = status == Draft

        operation addLine(productId: Product id, qty: int) {
          precondition isMutable()
          precondition qty > 0
          lines += OrderLine { productId: productId, quantity: qty }
        }

        operation confirm() {
          precondition isMutable()
          precondition lines.count > 0
          status := Confirmed
          emit OrderConfirmed { order: id, at: now() }
        }

        entity OrderLine {
          productId: Product id
          quantity: int
          invariant quantity > 0
        }

        test "adding a line then confirming yields a confirmed order" verifies TC-001 {
          let order = Order.create({
            customerId: "00000000-0000-0000-0000-000000000001",
            status: Draft,
            placedAt: "2024-01-01T00:00:00Z"
          })
          order.addLine("00000000-0000-0000-0000-000000000002", 2)
          order.confirm()
          expect(order.status).toBe(Confirmed)
          expect(order.lines.count).toBe(1)
        }

        test "lines cannot be added once the order is confirmed" verifies TC-002 {
          let order = Order.create({
            customerId: "00000000-0000-0000-0000-000000000001",
            status: Draft,
            placedAt: "2024-01-01T00:00:00Z"
          })
          order.addLine("00000000-0000-0000-0000-000000000002", 2)
          order.confirm()
          expect(order.addLine("00000000-0000-0000-0000-000000000002", 1)).toThrow()
        }
      }

      repository Customers for Customer { }
      repository Products for Product { }
      repository Orders for Order { }

      workflow placeOrder transactional {
        create(customerId: Customer id, productId: Product id, qty: int) {
          precondition qty > 0
          let customer = Customers.getById(customerId)
          let product = Products.getById(productId)
          let order = Order.create({
            customerId: customer.id,
            status: Draft,
            placedAt: now()
          })
          order.addLine(productId, qty)
          order.confirm()
        }
      }
    }
  }

  ui WebApp with scaffold(subdomains: [Sales]) {
  }

  storage primary { type: postgres }
  resource salesState { for: Sales, kind: state, use: primary }
  // Backs Product's `spec: File?` — an objectStore is required for a `File`
  // field to resolve.  Nothing in the leg uploads through it; it exists so the
  // FileRef emission path is compiled.
  storage blobs { type: localDisk }
  resource salesFiles { for: Sales, kind: objectStore, use: blobs }

  deployable api {
    platform: node
    contexts: [Sales]
    dataSources: [salesState, salesFiles]
    port: 3000
  }

  // Flutter frontend — the only structural difference from the react twin.
  // `platform: flutter` self-hosts (no static-bundle host): the deployable is a
  // real Flutter project built by the SDK (`flutter build web` → `build/web`).
  deployable webApp {
    platform: flutter
    targets: api
    ui: WebApp
    port: 3001
  }

  // System e2e tests.  `against api` (Hono) lowers to a vitest + fetch suite the
  // behavioral api tier runs.  There is deliberately NO `against webApp` case
  // here: that lowering emits Playwright page objects, and Flutter web has no DOM
  // for them to select (see the header).  The flutter leg's UI round-trip is
  // asserted by `run-ui-flutter.mjs` at the wire layer instead.
  test e2e "create a product and read it back" against api {
    let p = api.products.create({ sku: "WIDGET-1", price: { amount: 9.99, currency: "USD" } })
    let read = api.products.getById(p)
    expect(read.sku).toBe("WIDGET-1")
  }

  test e2e "create, add a line to, and confirm an order" against api {
    let prod = api.products.create({ sku: "WIDGET-2", price: { amount: 5.00, currency: "USD" } })
    let cust = api.customers.create({ name: "Buyer", email: "buyer@acme.test" })
    let ord = api.orders.create({ customerId: cust.id, status: "Draft", placedAt: "2024-01-01T00:00:00Z" })
    api.orders.addLine(ord, { productId: prod.id, qty: 3 })
    api.orders.confirm(ord)
    let read = api.orders.getById(ord)
    expect(read.status).toBe("Confirmed")
    expect(read.lines.length).toBe(1)
  }

}

solution SOL-001 for US-001 {
  title: "Ordering flows through the Order aggregate and the placeOrder workflow"
  entitles [
    Sales.Sales.Order.addLine,
    Sales.Sales.Order.confirm,
    Sales.Sales.placeOrder
  ]
}

testCase TC-001 verifies AC-001 {
  title: "Add a line then confirm the order"
  covers [
    Sales.Sales.Order.addLine,
    Sales.Sales.Order.confirm
  ]
}

testCase TC-002 verifies AC-002 {
  title: "Adding a line to a confirmed order is rejected"
  covers [ Sales.Sales.Order.addLine ]
}
